---
// Mockup B: Architectural Swiss Dossier & Monospaced Craft (Non-Generic Light Art Direction)
import '../styles/global.css';

const pageTitle = "Robiul Hasan — IT Systems & Cloud Dossier [Architectural Light]";
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet" />
    <style>
      .font-editorial {
        font-family: 'Syne', 'Plus Jakarta Sans', sans-serif;
      }
      .font-tech-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      .paper-card {
        background-color: #ffffff;
        border: 1px solid #1a1a1a;
        box-shadow: 4px 4px 0px #1a1a1a;
      }
      .paper-card-subtle {
        background-color: #ffffff;
        border: 1px solid #dcdad3;
      }
      .stamp-badge {
        display: inline-block;
        padding: 2px 8px;
        border: 1.5px solid #002aff;
        color: #002aff;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
    </style>
  </head>
  <body class="bg-[#f3f2ec] text-[#161616] font-sans antialiased selection:bg-[#002aff] selection:text-white">
    
    <!-- Top Controller Navigation Bar -->
    <div class="sticky top-0 z-50 bg-[#f3f2ec]/95 backdrop-blur-md border-b border-[#1a1a1a] px-4 sm:px-8 py-2.5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3 font-tech-mono text-xs tracking-wider">
        <span class="inline-block w-2.5 h-2.5 bg-[#002aff]"></span>
        <span class="text-[#161616] font-extrabold uppercase">DIRECTION B // ARCHITECTURAL DOSSIER</span>
        <span class="text-[#8e8c85] hidden sm:inline">&bull;</span>
        <span class="text-[#555] hidden sm:inline">SWISS TYPOGRAPHIC EDITORIAL</span>
      </div>

      <div class="flex items-center gap-3 font-tech-mono text-xs">
        <a href="/preview-dark" class="px-3 py-1 bg-[#1a1a1a] hover:bg-black text-white rounded-none transition-colors flex items-center gap-1.5 font-bold">
          &larr; Switch to Direction A (Blueprint Dark)
        </a>
      </div>
    </div>

    <!-- Main Architectural Paper Canvas -->
    <div class="max-w-[1300px] mx-auto px-4 sm:px-8 py-10 lg:py-16 space-y-16">
      
      <!-- TOP MASTHEAD & HEADER -->
      <header class="border-b-4 border-[#161616] pb-8 space-y-6">
        
