        </div>

      </header>

      <!-- 3-COLUMN METRICS GRID -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 font-tech-mono">
        
        <div class="paper-card p-6 space-y-2">
          <div class="text-[11px] text-[#666] uppercase font-bold tracking-wider">// MONITORED FLEET</div>
          <div class="text-4xl sm:text-5xl font-extrabold font-editorial text-[#121212]">2,500+</div>
          <div class="text-xs text-[#444] border-t border-[#eee] pt-2">Active enterprise endpoints under management</div>
        </div>

        <div class="paper-card p-6 space-y-2">
          <div class="text-[11px] text-[#666] uppercase font-bold tracking-wider">// SECURITY ASSETS</div>
          <div class="text-4xl sm:text-5xl font-extrabold font-editorial text-[#002aff]">1,100+</div>
          <div class="text-xs text-[#444] border-t border-[#eee] pt-2">Administered antivirus & endpoint devices</div>
        </div>

        <div class="paper-card p-6 space-y-2">
          <div class="text-[11px] text-[#666] uppercase font-bold tracking-wider">// IT PROJECTS</div>
          <div class="text-4xl sm:text-5xl font-extrabold font-editorial text-[#121212]">25+</div>
