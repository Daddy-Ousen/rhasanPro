            <div>ENTERPRISE CLOUD CANDIDATE</div>
            <div class="text-[#002aff] font-bold">RHASAN.PRO &bull; 2026 EDITION</div>
          </div>
        </div>

        <!-- Role Headline Banner -->
        <div class="bg-[#161616] text-[#f3f2ec] p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-tech-mono">
          <div class="text-xs sm:text-sm font-medium">
            <span class="text-[#00e5ff] font-bold">&gt; ROLE:</span> IT Support Engineer L2 &bull; Microsoft 365, Azure & Endpoint Security
          </div>
          <div class="flex items-center gap-4 text-xs">
            <a href="#contact" class="px-3 py-1 bg-[#002aff] hover:bg-blue-600 text-white font-bold transition-colors">
              CONTACT &rarr;
            </a>
            <a href="/Robiul_Hasan_CV.pdf" download class="underline hover:text-white transition-colors">
              DOWNLOAD CV (PDF)
            </a>
