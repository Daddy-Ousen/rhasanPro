            <h1 class="text-5xl sm:text-7xl lg:text-8xl font-extrabold font-editorial tracking-tighter text-[#121212] uppercase leading-none">
              ROBIUL HASAN
            </h1>
          </div>

          <div class="font-tech-mono text-xs text-right space-y-1 text-[#444] border-l-2 md:border-l-0 md:border-r-2 border-[#161616] pl-3 md:pl-0 md:pr-3">
