---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyHero from '../../components/CaseStudyHero.astro';
import StackCard from '../../components/StackCard.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { dossier } from '../../data/dossier';

const project = projects.find((p) => p.slug === 'oggro-tech') || projects[0];

const specs = [
  { label: 'Client', value: 'OGGRO Technologies Ltd' },
  { label: 'Hosting', value: 'Static export on Apache / WHM' },
  { label: 'Testing', value: 'Playwright end-to-end' },
  { label: 'Status', value: 'Live in production' },
];

const pillars = [
  { title: 'Static pre-rendering', body: 'Full static HTML export. No Node.js server at runtime, so pages arrive instantly.' },
  { title: 'Tailwind CSS v4', body: 'A small CSS bundle, compiled by Vite, with nothing left unused.' },
  { title: 'Playwright on every PR', body: 'Visual regression tests run before merge, so broken layouts never ship.' },
];
---

<BaseLayout title={`OGGRO Technologies case study | ${dossier.name}`} description={project.tagline}>

  <CaseStudyHero project={project} kicker="Client site · Production">
    <Fragment slot="actions">
      <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold">Visit oggro.tech <Icon name="external" /></a>
    </Fragment>
  </CaseStudyHero>

  <section class="wrap pt-16">
    <p class="kicker text-teal">Why it's fast</p>
    <h2 class="h2 mt-2">Three decisions that did the work</h2>
    <div class="mt-8 grid md:grid-cols-3 border-2 border-line bg-line gap-[2px]">
      {pillars.map((p) => (
        <div class="bg-card p-6 grid gap-2 content-start">
          <h3 class="h3">{p.title}</h3>
          <p class="text-[16px] leading-relaxed text-muted">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap py-16 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-8 grid gap-14 text-[18px] leading-relaxed">
      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">The brief</p>
        <h2 class="h2">Fast everywhere, and safe to change</h2>
        <p>{project.overview}</p>
        <p class="text-muted">{project.challenge}</p>
      </div>

      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">The build</p>
        <h2 class="h2">Static by default, tested on every merge</h2>
        <p>{project.solution}</p>
      </div>

      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">Results</p>
        <h2 class="h2">The numbers</h2>
        <ul class="grid gap-3 text-[17px]">
          {project.impact.map((item) => (
            <li class="flex gap-3"><span class="led mt-2.5" aria-hidden="true"></span><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <aside class="lg:col-span-4 lg:sticky lg:top-24 self-start grid gap-6">
      <StackCard specs={specs} technologies={project.technologies} />
    </aside>
  </section>

</BaseLayout>
