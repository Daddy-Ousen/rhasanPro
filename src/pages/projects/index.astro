---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import { dossier } from '../../data/dossier';

const categories = ["All", "AI & Automation", "Web Systems"];
---

<BaseLayout
  title={`Projects & Engineering Case Studies | ${dossier.name}`}
  description="Explore technical case studies spanning autonomous AI agents, high-speed Next.js platforms, and enterprise MSP deployments."
>
  
  <div class="px-4 py-16 sm:py-24 max-w-6xl mx-auto space-y-12">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        <span>PRODUCTION SYSTEMS & RESEARCH</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white light:text-slate-950 tracking-tight leading-tight">
        Engineering Projects & Deep-Dive Case Studies
      </h1>
      <p class="text-slate-400 light:text-slate-600 text-sm sm:text-base mt-4 leading-relaxed">
        From self-hosted agentic tool-calling daemons to zero-runtime marketing architectures and global hackathon achievements.
      </p>
    </div>

    <!-- Category Filter Chips -->
    <div class="flex items-center justify-center gap-2 flex-wrap pb-4">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat}
          class={`project-filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all cursor-pointer ${
            idx === 0
              ? 'bg-amber-500/20 text-amber-400 border border-amber-500/40 font-semibold'
              : 'bg-slate-800/80 light:bg-slate-100 text-slate-400 light:text-slate-600 hover:text-slate-200 light:hover:text-slate-900 border border-white/5 light:border-slate-300'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Full-Width High-Information Projects List -->
    <div class="space-y-10">
      {projects.map((project) => (
        <div
          class="project-card double-bezel-outer"
          data-project-category={project.category}
        >
          <div class="double-bezel-inner p-8 sm:p-10 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] light:bg-white space-y-6">
            
            <!-- Card Header: Badge & Actions -->
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
              <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-500/10 light:bg-amber-100 text-amber-400 light:text-amber-800 border border-amber-500/20 light:border-amber-300 text-xs font-medium font-mono">
                  {project.badge}
                </div>
                <h3 class="text-2xl sm:text-3xl font-bold text-white light:text-slate-950 tracking-tight">
                  {project.title}
                </h3>
              </div>
              
              <div class="flex items-center gap-3 self-start">
                <a 
                  href={project.caseStudyUrl} 
                  class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition-all shadow-md flex items-center gap-1.5 whitespace-nowrap"
                >
                  <span>Read Case Study</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>

                {project.githubUrl && (
                  <a 
                    href={project.githubUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="px-3.5 py-2.5 rounded-xl bg-slate-900/80 light:bg-slate-100 hover:bg-slate-800 light:hover:bg-slate-200 text-slate-200 light:text-slate-800 text-xs font-medium border border-white/10 light:border-slate-300 transition-colors flex items-center gap-2"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                    <span>GitHub</span>
                  </a>
                )}

                {project.liveUrl && (
                  <a 
                    href={project.liveUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="px-3.5 py-2.5 rounded-xl bg-slate-900/80 light:bg-slate-100 hover:bg-slate-800 light:hover:bg-slate-200 text-slate-200 light:text-slate-800 text-xs font-medium border border-white/10 light:border-slate-300 transition-colors flex items-center gap-1.5"
                  >
                    <span>Live Site</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                )}
              </div>
            </div>

            <!-- Deep Narrative Overview -->
            <p class="text-slate-300 light:text-slate-700 leading-relaxed text-sm sm:text-base">
              {project.overview}
            </p>

            <!-- 3 Rich Architectural Subcards -->
            {project.subcards && project.subcards.length > 0 && (
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
                {project.subcards.map((subcard) => (
                  <div class="p-4 rounded-xl bg-slate-950/60 light:bg-slate-50 border border-white/5 light:border-slate-200 space-y-2 shadow-sm">
                    <div class="font-bold text-white light:text-slate-900 text-sm flex items-center gap-2">
                      <span class={`w-2 h-2 rounded-full ${
                        subcard.dotColor === 'amber' ? 'bg-amber-400 shadow-[0_0_6px_#f59e0b]' :
                        subcard.dotColor === 'emerald' ? 'bg-emerald-400 shadow-[0_0_6px_#10b981]' :
                        'bg-cyan-400 shadow-[0_0_6px_#06b6d4]'
                      }`}></span>
                      <span>{subcard.title}</span>
                    </div>
                    <p class="text-xs text-slate-400 light:text-slate-600 leading-relaxed">
                      {subcard.description}
                    </p>
                  </div>
                ))}
              </div>
            )}

            <!-- Technology Tags Strip -->
            <div class="pt-4 border-t border-white/5 light:border-slate-200 flex flex-wrap items-center gap-1.5">
              {project.technologies.map((tech) => (
                <span class="px-2.5 py-1 rounded-md text-[10.5px] font-mono bg-slate-900 light:bg-slate-100 text-slate-400 light:text-slate-600 border border-white/5 light:border-slate-200">
                  {tech}
                </span>
              ))}
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>

</BaseLayout>

<script>
  function setupProjectsFilter() {
    const filterBtns = document.querySelectorAll('.project-filter-btn');
    const cards = document.querySelectorAll('.project-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');

        filterBtns.forEach((b) => {
          if (b === btn) {
            b.className = 'project-filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all bg-amber-500/20 text-amber-400 border border-amber-500/40 font-semibold cursor-pointer';
          } else {
            b.className = 'project-filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all bg-slate-800/80 light:bg-slate-100 text-slate-400 light:text-slate-600 hover:text-slate-200 light:hover:text-slate-900 border border-white/5 light:border-slate-300 cursor-pointer';
          }
        });

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-project-category');
          if (cat === 'All' || cardCat === cat) {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupProjectsFilter();
  document.addEventListener('astro:page-load', setupProjectsFilter);
</script>
