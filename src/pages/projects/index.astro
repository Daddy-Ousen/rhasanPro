---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { dossier } from '../../data/dossier';
import { metaFor, shortTitle, toneClass } from '../../data/tones';

const categories = ['All', 'AI & Automation', 'Web Systems'];
---

<BaseLayout
  title={`Projects | ${dossier.name}`}
  description="Case studies: a daily tech and AI news platform, a self-hosted AI agent, a production Next.js site, and an AMD hackathon build."
>

  <PageHeader
    kicker="Projects"
    intro="Side projects, client work and one hackathon. Each has a case study with the problem, the build and the numbers."
  >
    Things I <span class="hl">built.</span>
  </PageHeader>

  <section class="wrap py-12">
    <div class="flex flex-wrap gap-1.5 mb-10" role="group" aria-label="Filter projects">
      {categories.map((cat, i) => (
        <button type="button" data-category={cat} aria-pressed={i === 0 ? 'true' : 'false'} class="project-filter-btn chip">{cat}</button>
      ))}
    </div>

    <div class="grid gap-10">
      {projects.map((project) => {
        const meta = metaFor(project.id);
        return (
          <article class="project-card box lift grid lg:grid-cols-12" data-project-category={project.category}>
            <div class={`${toneClass[meta.tone === 'card' ? 'teal' : meta.tone]} lg:col-span-5 p-6 sm:p-8 flex flex-col gap-4 border-b-2 lg:border-b-0 lg:border-r-2 border-line`}>
              <p class="kicker opacity-90">{meta.tag}</p>
              <h2 class="h1 text-[clamp(40px,5vw,64px)]">{shortTitle(project.title)}</h2>
              <p class="text-[17px] leading-relaxed">{meta.blurb}</p>
              <dl class="mt-auto pt-5 border-t-2 border-current grid grid-cols-3 gap-3">
                {project.metrics.map((m) => (
                  <div>
                    <dt class="text-[13px] opacity-90">{m.label}</dt>
                    <dd class="font-display font-extrabold text-xl leading-tight">{m.value}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col gap-6">
              <p class="text-[16px] leading-relaxed">{project.overview}</p>

              <ul class="grid gap-3 sm:grid-cols-3">
                {project.subcards.map((sub) => (
                  <li class="border-2 border-line bg-sunk p-4">
                    <p class="font-bold leading-snug">{sub.title}</p>
                    <p class="mt-1.5 text-[14px] leading-relaxed text-muted">{sub.description}</p>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-1.5 text-muted">
                {project.technologies.map((t) => <span class="tag">{t}</span>)}
              </div>

              <div class="mt-auto flex flex-wrap gap-3">
                <a href={project.caseStudyUrl} class="btn btn-teal">Read case study <Icon name="arrow" /></a>
                {project.liveUrl && (
                  <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn">Live site <Icon name="external" /></a>
                )}
                {project.githubUrl && (
                  <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn"><Icon name="github" /> GitHub</a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

</BaseLayout>

<script>
  function setupProjectsFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.project-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        cards.forEach((card) => {
          card.hidden = !(cat === 'All' || card.dataset.projectCategory === cat);
        });
      })
    );
  }

  document.addEventListener('astro:page-load', setupProjectsFilter);
</script>
