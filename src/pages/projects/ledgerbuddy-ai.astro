---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyHero from '../../components/CaseStudyHero.astro';
import StackCard from '../../components/StackCard.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { dossier } from '../../data/dossier';

const project = projects.find((p) => p.slug === 'ledgerbuddy-ai') || projects[0];

const certificateUrl = 'https://lablab.ai/u/@rhasan22959110/ai-hackathons/amd-developer-hackathon-act-ii/certificate';

const specs = [
  { label: 'Event', value: 'AMD AI Developer Hackathon, Act II' },
  { label: 'Platform', value: 'Lablab.ai' },
  { label: 'Licence', value: 'Open source (MIT)' },
  { label: 'Repository', value: 'Daddy-Ousen/LedgerBuddyAIMVP' },
];
---

<BaseLayout title={`LedgerBuddy AI case study | ${dossier.name}`} description={project.tagline}>

  <CaseStudyHero project={project} kicker="AMD AI Hackathon · Act II">
    <Fragment slot="actions">
      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn"><Icon name="github" /> Source on GitHub</a>
      )}
      <a href={certificateUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold">Certificate <Icon name="external" /></a>
    </Fragment>
  </CaseStudyHero>

  <section class="wrap py-16 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-8 grid gap-14 text-[18px] leading-relaxed">
      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">The problem</p>
        <h2 class="h2">Receipts don't come in one shape</h2>
        <p>{project.challenge}</p>
      </div>

      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">The build</p>
        <h2 class="h2">OCR, a schema, and arithmetic that must balance</h2>
        <p>{project.solution}</p>
        <p class="text-muted">
          The engine takes PDF, PNG and JPEG invoices, runs them through OCR pre-processing, and asks an LLM to fill strict Pydantic schemas. An arithmetic check flags any entry where debit ≠ credit before it reaches PostgreSQL.
        </p>
        <div class="grid sm:grid-cols-3 border-2 border-line bg-line gap-[2px] text-[16px]">
          {project.subcards.map((sub) => (
            <div class="bg-card p-4">
              <p class="font-bold">{sub.title}</p>
              <p class="mt-1.5 text-[14px] leading-relaxed text-muted">{sub.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">Results</p>
        <h2 class="h2">How it went</h2>
        <ul class="grid gap-3 text-[17px]">
          {project.impact.map((item) => (
            <li class="flex gap-3"><span class="led mt-2.5" aria-hidden="true"></span><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <aside class="lg:col-span-4 lg:sticky lg:top-24 self-start grid gap-6">
      <StackCard specs={specs} technologies={project.technologies} />
    </aside>
  </section>

</BaseLayout>
