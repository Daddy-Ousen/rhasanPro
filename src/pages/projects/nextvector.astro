---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyHero from '../../components/CaseStudyHero.astro';
import StackCard from '../../components/StackCard.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { dossier } from '../../data/dossier';

const project = projects.find((p) => p.slug === 'nextvector') || projects[0];

const specs = [
  { label: 'Scope', value: 'Daily tech & AI news' },
  { label: 'Newsletter', value: 'The Morning Vector' },
  { label: 'Model registry', value: '135+ models, growing' },
  { label: 'Labs tracked', value: '24+' },
  { label: 'Built with', value: 'React 19, Vite 8, Tailwind v4' },
  { label: 'Hosting', value: 'Edge CDN / Vercel' },
];
---

<BaseLayout title={`NextVector case study | ${dossier.name}`} description={project.tagline}>

  <CaseStudyHero project={project} kicker="Tech news · Newsletter · AI model registry">
    <Fragment slot="actions">
      <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold">Read NextVector <Icon name="external" /></a>
      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn"><Icon name="github" /> GitHub</a>
      )}
    </Fragment>
  </CaseStudyHero>

  <section class="wrap py-16 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-8 grid gap-14 text-[18px] leading-relaxed">

      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">The idea</p>
        <h2 class="h2">Less noise. More signal.</h2>
        <p>
          Tech news drowns in press releases, recycled headlines and cherry-picked benchmarks. I built <strong>NextVector</strong> as an independent daily publication that explains what actually changed, with real technical depth.
        </p>
        <p>Every story answers the same three questions:</p>
        <ol class="grid gap-0 border-2 border-line bg-line gap-y-[2px] text-[17px]">
          <li class="bg-card p-4 flex gap-4"><span class="font-display font-extrabold text-3xl leading-none text-pink">1</span><span><strong>What happened?</strong> The verified event, without the hype.</span></li>
          <li class="bg-card p-4 flex gap-4"><span class="font-display font-extrabold text-3xl leading-none text-pink">2</span><span><strong>Why does it matter?</strong> The technical or structural significance.</span></li>
          <li class="bg-card p-4 flex gap-4"><span class="font-display font-extrabold text-3xl leading-none text-pink">3</span><span><strong>What could happen next?</strong> Second-order effects and realistic timelines.</span></li>
        </ol>
      </div>

      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">Daily coverage</p>
        <h2 class="h2">The Morning Vector</h2>
        <p>
          Alongside the site, NextVector sends <strong>The Morning Vector</strong>, a newsletter that turns the day's big shifts into a three-minute read for developers, architects and technical leads.
        </p>
        <p class="text-muted">
          Readers get a signal-purity slider to filter stories (70–100), audio narration, a live breaking-news ticker, and a command palette (Ctrl+K) to jump anywhere.
        </p>
      </div>

      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">Built in</p>
        <h2 class="h2">A model registry and a benchmark watchdog</h2>
        <p>
          Instead of linking to someone else's tables, NextVector has its own <strong>AI model registry</strong>. It tracks <strong>135+ frontier models from 24+ labs</strong>, from OpenAI, Anthropic and Google DeepMind to DeepSeek, Qwen and Mistral, and grows as new models ship.
        </p>
        <ul class="grid gap-3 text-[17px]">
          <li class="flex gap-3"><span class="led mt-2.5" aria-hidden="true"></span><span><strong>Table and card views</strong> with LMSYS Arena Elo, context length, parameters and token pricing.</span></li>
          <li class="flex gap-3"><span class="led mt-2.5" aria-hidden="true"></span><span><strong>Side-by-side comparison</strong> of architecture, hardware needs and benchmark scores.</span></li>
          <li class="flex gap-3"><span class="led mt-2.5" aria-hidden="true"></span><span><strong>Token cost estimator</strong> for monthly inference budgets.</span></li>
          <li class="flex gap-3"><span class="led mt-2.5" aria-hidden="true"></span><span><strong>Benchmark watchdog</strong> checking claims against OSWorld, WebArena, SWE-bench Verified and Cyber-Eval for contamination.</span></li>
        </ul>
      </div>

      <div class="grid gap-6">
        <div class="max-w-[65ch]">
          <p class="kicker text-teal">Pipeline</p>
          <h2 class="h2 mt-2">From story to inbox, in four steps</h2>
        </div>
        <ol class="grid sm:grid-cols-2 border-2 border-line bg-line gap-[2px]">
          {project.diagramSteps?.map((step) => (
            <li class="bg-card p-5 grid gap-2 content-start">
              <span class="font-display font-extrabold text-5xl leading-none text-teal">{step.step}</span>
              <h3 class="font-bold text-lg">{step.title}</h3>
              <p class="text-[15px] leading-relaxed text-muted">{step.desc}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">Results</p>
        <h2 class="h2">What it does today</h2>
        <ul class="grid gap-3 text-[17px]">
          {project.impact.map((point) => (
            <li class="flex gap-3"><span class="led mt-2.5" aria-hidden="true"></span><span>{point}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <aside class="lg:col-span-4 lg:sticky lg:top-24 self-start grid gap-6">
      <StackCard specs={specs} technologies={project.technologies} />
    </aside>
  </section>

  <section class="wrap">
    <div class="fill-navy border-2 border-line lift p-6 sm:p-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h2 class="h2">Read today's issue</h2>
        <p class="mt-3 opacity-90 max-w-[55ch]">Daily tech news, The Morning Vector, and the full model registry.</p>
      </div>
      <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-gold">Open NextVector <Icon name="external" /></a>
    </div>
  </section>

</BaseLayout>
