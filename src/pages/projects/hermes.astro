---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyHero from '../../components/CaseStudyHero.astro';
import StackCard from '../../components/StackCard.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { dossier } from '../../data/dossier';

const project = projects.find((p) => p.slug === 'hermes') || projects[0];

const specs = [
  { label: 'Runs as', value: 'systemd daemon on Linux' },
  { label: 'Tool interface', value: 'Pydantic JSON schemas' },
  { label: 'Browser engine', value: 'Playwright Chromium' },
  { label: 'Status', value: 'Personal project, Feb 2026 – now' },
];
---

<BaseLayout title={`Hermes case study | ${dossier.name}`} description={project.tagline}>

  <CaseStudyHero project={project} kicker="Agentic AI · Self-hosted">
    <Fragment slot="actions">
      {project.githubUrl && (
        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn"><Icon name="github" /> GitHub</a>
      )}
    </Fragment>
  </CaseStudyHero>

  <section class="wrap pt-16">
    <p class="kicker text-teal">How a request runs</p>
    <h2 class="h2 mt-2 max-w-[20ch]">The tool-calling loop</h2>
    <ol class="mt-8 grid md:grid-cols-4 border-2 border-line bg-line gap-[2px]">
      {project.diagramSteps?.map((step) => (
        <li class="bg-card p-5 grid gap-2 content-start">
          <span class="font-display font-extrabold text-5xl leading-none text-pink">{step.step}</span>
          <h3 class="font-bold text-lg leading-snug">{step.title}</h3>
          <p class="text-[15px] leading-relaxed text-muted">{step.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap py-16 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-8 grid gap-14 text-[18px] leading-relaxed">
      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">The problem</p>
        <h2 class="h2">Too many tabs, too many terminals</h2>
        <p>{project.challenge}</p>
        <p class="text-muted">
          In a busy MSP, engineers run hundreds of small checks a day: API tokens, backup snapshots, CVE advisories, device registration across tenants. Every switch between a portal and a terminal adds delay and room for mistakes.
        </p>
      </div>

      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">The build</p>
        <h2 class="h2">A sandboxed agent that uses real tools</h2>
        <p>{project.solution}</p>
        <p class="text-muted">
          Hermes runs as an isolated systemd daemon. It listens on local UNIX sockets and REST endpoints and turns questions into strict Pydantic schemas. Each tool call runs in a worker process with tight permissions, and the output comes back as a short, useful summary.
        </p>
      </div>

      <div class="grid gap-5 max-w-[65ch]">
        <p class="kicker text-teal">Results</p>
        <h2 class="h2">What changed</h2>
        <ul class="grid gap-3 text-[17px]">
          {project.impact.map((item) => (
            <li class="flex gap-3"><span class="led mt-2.5" aria-hidden="true"></span><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <aside class="lg:col-span-4 lg:sticky lg:top-24 self-start grid gap-6">
      <StackCard specs={specs} technologies={project.technologies} />
      <div class="fill-gold border-2 border-line p-5">
        <h3 class="font-bold text-lg">Try a version of Hermes</h3>
        <p class="mt-2 text-[15px] leading-relaxed">A scoped web build answers questions about me. Open it with the “Ask Hermes” button in the corner.</p>
      </div>
    </aside>
  </section>

</BaseLayout>
