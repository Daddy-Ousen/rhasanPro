---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import { dossier } from '../../data/dossier';

const project = projects.find((p) => p.slug === 'hermes') || projects[0];
---

<BaseLayout
  title={`${project.title} — Technical Deep Dive | ${dossier.name}`}
  description={project.tagline}
>
  
  <div class="px-4 py-16 sm:py-24 max-w-5xl mx-auto space-y-16">
    
    <!-- Breadcrumb & Tag -->
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <a href="/projects" class="inline-flex items-center gap-1.5 text-xs font-mono text-amber-400 hover:text-amber-300">
        <span>←</span>
        <span>Back to Projects Matrix</span>
      </a>

      <span class="px-3 py-1 rounded-full text-xs font-mono bg-amber-500/10 text-amber-400 border border-amber-500/20">
        AI & Automation Deep Dive
      </span>
    </div>

    <!-- Case Study Header -->
    <div class="space-y-4">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {project.title}
      </h1>
      <p class="text-base sm:text-xl text-slate-300 leading-relaxed max-w-3xl">
        {project.subtitle}
      </p>

      <!-- Key Metrics Strip -->
      <div class="grid grid-cols-3 gap-4 pt-6 max-w-lg">
        {project.metrics.map((m) => (
          <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-white/10 text-center">
            <span class="block text-xs font-mono text-slate-400">{m.label}</span>
            <span class="block text-xl font-bold font-mono text-emerald-400 mt-1">{m.value}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Interactive Animated Tool Execution Flow Diagram -->
    <div class="double-bezel-outer">
      <div class="double-bezel-inner p-6 sm:p-10 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] text-slate-300 space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-amber-400 font-semibold">Architecture Runtime</span>
            <h3 class="text-xl font-bold text-white mt-1">Hermes Autonomous Tool Execution Loop</h3>
          </div>
          <span class="text-xs font-mono text-emerald-400 flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Sandboxed Daemon
          </span>
        </div>

        <!-- 4-Step Diagram Flow -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 relative pt-4">
          {project.diagramSteps?.map((step, idx) => (
            <div class="diagram-step-box p-4 rounded-2xl bg-slate-900/90 border border-white/10 hover:border-amber-500/40 transition-all flex flex-col justify-between relative group">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center font-mono font-bold text-xs">
                    0{step.step}
                  </span>
                  <span class="text-[10px] font-mono text-slate-500">Node #{idx + 1}</span>
                </div>
                <h4 class="text-sm font-bold text-white group-hover:text-amber-400 transition-colors">
                  {step.title}
                </h4>
                <p class="text-xs text-slate-400 mt-2 leading-relaxed">
                  {step.desc}
                </p>
              </div>

              <div class="mt-4 pt-2 border-t border-white/5 text-[10px] font-mono text-slate-500 flex items-center gap-1">
                <span class="text-emerald-400">✔</span>
                <span>Deterministic</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Case Study Narrative Breakdown -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      
      <div class="md:col-span-8 space-y-8 text-slate-300 text-sm leading-relaxed">
        
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/50 border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span>The Challenge</span>
          </h2>
          <p>{project.challenge}</p>
          <p>
            In high-tempo MSP environments, engineers execute hundreds of repetitive verification commands daily: polling API tokens, verifying backup snapshots, retrieving CVE advisories, and checking device registration status across tenants. Context switching between web portals and terminals creates compounding latency and human error.
          </p>
        </div>

        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/50 border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>The Engineered Solution</span>
          </h2>
          <p>{project.solution}</p>
          <p>
            Hermes runs as an isolated systemd daemon on Linux. It binds to local UNIX sockets and REST interfaces, parsing conversational queries into strict Pydantic JSON schemas. When a tool call is generated, it executes inside a sub-process worker with strict permission boundaries, capturing stdout and returning actionable summaries in milliseconds.
          </p>
        </div>

        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/50 border border-white/10 space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            <span>Quantified Impact</span>
          </h2>
          <ul class="space-y-2.5">
            {project.impact.map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold text-base leading-none mt-0.5">▹</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>

      <!-- Tech Stack & Specifications Sidebar -->
      <div class="md:col-span-4 space-y-6">
        <div class="p-6 rounded-3xl bg-slate-900/80 border border-white/10 space-y-4">
          <h3 class="text-xs font-mono uppercase tracking-widest text-amber-400 font-semibold">Core Stack</h3>
          <div class="flex flex-wrap gap-1.5">
            {project.technologies.map((tech) => (
              <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-slate-800 text-slate-200 border border-white/5">
                {tech}
              </span>
            ))}
          </div>

          <div class="pt-4 border-t border-white/10 space-y-2 text-xs font-mono text-slate-400">
            <div class="flex justify-between">
              <span>DEPLOYMENT:</span>
              <span class="text-slate-200">Systemd Linux</span>
            </div>
            <div class="flex justify-between">
              <span>TOOL INTERFACE:</span>
              <span class="text-slate-200">Pydantic Schemas</span>
            </div>
            <div class="flex justify-between">
              <span>HEADLESS ENGINE:</span>
              <span class="text-slate-200">Playwright Chromium</span>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-amber-500/10 border border-amber-500/20 text-center space-y-3">
          <h4 class="text-sm font-bold text-white">Experience Hermes Live</h4>
          <p class="text-xs text-slate-300">
            You can interact with a specialized knowledge-scoped web build of Hermes right on this portfolio using the bottom-right chat widget!
          </p>
        </div>
      </div>

    </div>

  </div>

</BaseLayout>
