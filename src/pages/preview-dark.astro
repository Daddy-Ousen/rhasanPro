              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>IT Documentation & SOPs</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Client & Stakeholder Relations</li>
            </ul>
          </div>

          <!-- Automation & AI -->
          <div class="p-5 rounded-xl bg-slate-900/50 border border-slate-800 space-y-3">
