---
// Direction A Refined: Senior Systems & Cloud Infrastructure Engineer (Human, Precise, High Credibility)
import '../styles/global.css';

const pageTitle = "Robiul Hasan — IT Infrastructure & Systems Engineer";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#0b0f17] text-slate-200 font-sans antialiased selection:bg-amber-500 selection:text-slate-950">
    
    <!-- Top Status Bar & Navigation -->
    <div class="sticky top-0 z-50 bg-[#0b0f17]/90 backdrop-blur-md border-b border-slate-800/80">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="#" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-700 flex items-center justify-center font-mono text-xs font-bold text-amber-400 group-hover:border-amber-400/50 transition-colors">
            RH
          </div>
          <div>
            <span class="font-bold text-white text-sm tracking-tight group-hover:text-amber-400 transition-colors">Robiul Hasan</span>
            <span class="hidden sm:inline text-xs text-slate-400 font-mono ml-2">&bull; Dhaka, BD</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
          <a href="#about" class="hover:text-white transition-colors">About</a>
          <a href="#experience" class="hover:text-white transition-colors">Experience</a>
          <a href="#skills" class="hover:text-white transition-colors">Skills</a>
          <a href="#hermes" class="hover:text-white transition-colors">Hermes AI</a>
          <a href="#credentials" class="hover:text-white transition-colors">Credentials</a>
          <a href="#contact" class="hover:text-white transition-colors">Contact</a>
        </nav>

        <div class="flex items-center gap-3">
          <a 
            href="/Robiul_Hasan_CV.pdf" 
            download 
            class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-medium transition-colors flex items-center gap-2"
          >
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Download CV
          </a>
        </div>
      </div>
    </div>

    <!-- Main Container -->
    <main class="max-w-6xl mx-auto px-6 py-12 lg:py-16 space-y-24">
      
      <!-- HERO SECTION -->
      <section class="space-y-8 pt-4">
        
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-slate-900/80 border border-slate-800 text-xs text-slate-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Available for Systems Administration & Cloud Infrastructure Roles</span>
        </div>

        <div class="space-y-4 max-w-3xl">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.1]">
            Keeping enterprise systems reliable, compliant, and automated.
          </h1>
