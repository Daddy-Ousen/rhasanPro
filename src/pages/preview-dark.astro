              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Datto BCDR & Datto RMM</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Endpoint & Antivirus Security</li>
            </ul>
          </div>

          <!-- Operations -->
          <div class="p-5 rounded-xl bg-slate-900/50 border border-slate-800 space-y-3">
