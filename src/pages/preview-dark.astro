              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>Microsoft Intune</li>
            </ul>
          </div>

          <!-- Infrastructure -->
          <div class="p-5 rounded-xl bg-slate-900/50 border border-slate-800 space-y-3">
            <h3 class="text-sm font-bold text-white tracking-wide">Infrastructure</h3>
            <ul class="space-y-1.5 text-xs text-slate-300">
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Windows Server & Hyper-V</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Active Directory & Group Policy</li>
