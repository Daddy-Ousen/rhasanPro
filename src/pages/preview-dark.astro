            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-slate-800 pb-4">
              <div>
                <h3 class="text-xl font-bold text-white">L2 Support Engineer & Service Desk Co-Leader</h3>
                <div class="text-sm text-amber-400 font-medium mt-0.5">Techants Solutions Pty Ltd &bull; Dhaka, Bangladesh</div>
              </div>
