            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-slate-800/80 pb-4">
              <div>
                <h3 class="text-lg font-bold text-white">Jr. Support Engineer</h3>
                <div class="text-sm text-slate-400 font-medium mt-0.5">Cobait Dhaka &bull; Dhaka, Bangladesh</div>
              </div>
              <span class="text-xs font-mono text-slate-400 bg-slate-800/60 px-3 py-1 rounded-full w-fit">
                2021 – 2022
              </span>
            </div>

            <ul class="space-y-2 text-sm text-slate-300 leading-relaxed list-disc list-inside">
