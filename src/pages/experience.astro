---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Icon from '../components/Icon.astro';
import { dossier } from '../data/dossier';

const stats = [
  { value: '2,500+', label: 'endpoints maintained', tone: 'fill-card' },
  { value: '1,100+', label: 'Bitdefender EDR assets', tone: 'fill-teal' },
  { value: '25+', label: 'projects delivered', tone: 'fill-gold' },
  { value: '90%+', label: 'sustained CSAT', tone: 'fill-pink' },
];
---

<BaseLayout
  title={`Experience | ${dossier.name}`}
  description="Career timeline across Techants Solutions, Cobait Dhaka, and AQSBD: service desk leadership, endpoint security, and BCDR."
>

  <PageHeader
    kicker="Experience"
    intro="From first-line triage to co-leading a multi-tier MSP service desk. Newest first."
  >
    Five years of <span class="hl">keeping the lights on.</span>
  </PageHeader>

  <section class="wrap pt-12">
    <dl class="grid grid-cols-2 lg:grid-cols-4 border-2 border-line bg-line gap-[2px]">
      {stats.map((s) => (
        <div class={`${s.tone} p-5 sm:p-6`}>
          <dd class="font-display font-extrabold text-[clamp(34px,4.4vw,56px)] leading-none tabular-nums">{s.value}</dd>
          <dt class="mt-2 text-[15px]">{s.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <section class="wrap py-16">
    <ExperienceTimeline />
  </section>

  <section class="wrap">
    <div class="fill-navy border-2 border-line lift p-6 sm:p-10 grid gap-8 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-8">
        <p class="kicker opacity-90">Also on my desk</p>
        <h2 class="h2 mt-3">Quarterly SDO audits and backup appliance checks</h2>
        <p class="mt-4 text-[17px] leading-relaxed opacity-90 max-w-[65ch]">
          Every quarter I audit client fleets for Service Delivery Optimisation: RTO and RPO targets, patch compliance and security posture. I also run the on-site Datto SIRIS and ALTO appliances and Acronis cloud backups, so restore drills lose nothing.
        </p>
      </div>
      <div class="lg:col-span-4 grid gap-3">
        <a href={dossier.resumePdfUrl} download="Robiul_Hasan_CV.pdf" class="btn btn-gold">Download CV <Icon name="download" /></a>
        <a href="/contact" class="btn">Talk to me <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

</BaseLayout>
