---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
import Icon from '../components/Icon.astro';
import { dossier } from '../data/dossier';
---

<BaseLayout
  title={`Skills | ${dossier.name}`}
  description="Robiul Hasan's technical skills across cloud and identity, systems, endpoint security, BCDR, service desk leadership, and automation."
>

  <PageHeader
    kicker="Skills"
    intro="Six areas, 24 skills, each with an honest level. Filter by area or search for a tool."
  >
    What I can <span class="hl">actually do.</span>
  </PageHeader>

  <section class="wrap py-12">
    <SkillsMatrix />
  </section>

  <section class="wrap">
    <div class="fill-gold border-2 border-line lift p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h2 class="h3">Need proof?</h2>
        <p class="mt-2 max-w-[60ch]">MD-102, MD-100, the AMD hackathon and the Python specialisation all have issuer records.</p>
      </div>
      <a href="/credentials" class="btn">See credentials <Icon name="arrow" /></a>
    </div>
  </section>

</BaseLayout>
