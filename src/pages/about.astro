---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { dossier } from '../data/dossier';

const facts = [
  { label: 'Based in', value: dossier.location },
  { label: 'Timezone', value: dossier.timezone },
  { label: 'Experience', value: dossier.yearsOfExperience },
  { label: 'Fleet', value: '2,500+ endpoints' },
  { label: 'EDR', value: '1,100+ Bitdefender assets' },
  { label: 'Team', value: '10+ engineers co-led' },
];

const principles = [
  {
    tone: 'fill-teal',
    title: 'A backup is only real after a restore',
    body: 'Every appliance gets verified: screenshot boot checks, off-site copies, and recovery points under 15 minutes. Drills, not hope.',
    stack: 'Datto SIRIS · Acronis · SDO audits',
  },
  {
    tone: 'fill-pink',
    title: 'Trust nothing, verify every device',
    body: 'Conditional access, MFA everywhere, Intune compliance, BitLocker keys escrowed, and EDR telemetry watching around the clock.',
    stack: 'Bitdefender EDR · Intune · Entra ID',
  },
  {
    tone: 'fill-gold',
    title: 'If I do it twice, I script it',
    body: 'Repeated manual work is debt. PowerShell and Bash for the fleet, Playwright for the web, and sandboxed AI agents for the rest.',
    stack: 'PowerShell · Python · Agentic AI',
  },
];
---

<BaseLayout title={`About | ${dossier.name}`} description={dossier.fullBio}>

  <PageHeader
    kicker="About"
    intro="Five years in managed services. I co-lead a service desk, own the hard tickets, and build tools so the same fire does not start twice."
  >
    Hi, I'm Robiul. I keep systems <span class="hl">boring</span> on purpose.
    <div slot="aside" class="flex lg:justify-end">
      <div class="w-44 sm:w-56 aspect-square fill-teal border-2 border-line shadow-[8px_8px_0_var(--pink)] overflow-hidden">
        <img src={dossier.avatarUrl} alt={`Pixel-art portrait of ${dossier.name}`} class="pixel-img w-full h-full mix-blend-multiply" width="224" height="224" />
      </div>
    </div>
  </PageHeader>

  <section class="wrap py-16 grid gap-10 lg:grid-cols-12">
    <aside class="lg:col-span-4 lg:sticky lg:top-24 self-start box lift">
      <p class="kicker fill-gold border-b-2 border-line px-5 py-3">Quick facts</p>
      <dl class="divide-y-2 divide-line">
        {facts.map((f) => (
          <div class="flex justify-between gap-4 px-5 py-3">
            <dt class="text-muted">{f.label}</dt>
            <dd class="font-bold text-right">{f.value}</dd>
          </div>
        ))}
      </dl>
      <div class="p-5 border-t-2 border-line grid gap-3">
        <a href={dossier.resumePdfUrl} download="Robiul_Hasan_CV.pdf" class="btn btn-gold">Download CV <Icon name="download" /></a>
        <a href="/contact" class="btn">Get in touch <Icon name="arrow" /></a>
      </div>
    </aside>

    <div class="lg:col-span-8 grid gap-12">
      <div class="grid gap-5 text-[18px] leading-relaxed max-w-[65ch]">
        <h2 class="h2">The short version</h2>
        <p>
          I'm an L2 infrastructure and systems support engineer, and service desk co-lead, at <strong>Techants Solutions Pty Ltd</strong>, an Australian managed services provider.
        </p>
        <p>
          Day to day that means cloud migrations, endpoint compliance and disaster recovery for clients around the world. I look after more than <strong>2,500 endpoints</strong> and <strong>1,100 Bitdefender GravityZone</strong> protected devices.
        </p>
        <p>
          The other half of me writes software. Python tools that check Datto and Acronis backups, and AI agents like <a href="/projects/hermes" class="link">Hermes</a> that take the repetitive parts off my plate.
        </p>
      </div>

      <div class="box p-6 sm:p-8 grid gap-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="h3">Education</h2>
          <span class="kicker text-teal">{dossier.education.year}</span>
        </div>
        <div>
          <p class="font-bold text-lg">{dossier.education.degree}</p>
          <p class="text-muted">{dossier.education.institution}</p>
        </div>
        <ul class="grid gap-2 text-[16px]">
          {dossier.education.highlights.map((h) => (
            <li class="flex gap-3"><span class="led mt-2.5" aria-hidden="true"></span><span>{h}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="fill-pink border-y-2 border-line">
    <figure class="wrap py-16 sm:py-24 max-w-5xl">
      <p class="kicker opacity-90">How I lead</p>
      <blockquote class="h2 mt-5 text-[clamp(30px,4.4vw,58px)]">“{dossier.leadershipQuote}”</blockquote>
      <figcaption class="mt-6 font-pixel text-xs opacity-90">— Robiul, co-lead of a 10+ person service desk</figcaption>
    </figure>
  </section>

  <section class="wrap pt-16 sm:pt-20">
    <p class="kicker text-muted">House rules</p>
    <h2 class="h2 mt-2">Three things I don't compromise on</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {principles.map((p) => (
        <article class="box flex flex-col">
          <div class={`${p.tone} h-3 border-b-2 border-line`} aria-hidden="true"></div>
          <div class="p-6 flex flex-col gap-3 flex-1">
            <h3 class="h3">{p.title}</h3>
            <p class="text-[16px] leading-relaxed text-muted">{p.body}</p>
            <p class="mt-auto pt-3 kicker">{p.stack}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
