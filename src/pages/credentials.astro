---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CredentialCard from '../components/CredentialCard.astro';
import Icon from '../components/Icon.astro';
import { credentials } from '../data/credentials';
import { dossier } from '../data/dossier';

const categories = ['All', 'Microsoft Cloud', 'AI & Hackathons', 'Software & Linux'];
---

<BaseLayout
  title={`Certifications | ${dossier.name}`}
  description="Microsoft, AMD Hackathon, and systems engineering certifications earned by Robiul Hasan, with links to verify them."
>

  <PageHeader
    kicker="Credentials"
    intro="Microsoft Learn, AMD and Lablab.ai, the University of Michigan. Where a public record exists, you can check it yourself."
  >
    Certified, and <span class="hl">you can check.</span>
  </PageHeader>

  <section class="wrap py-12">
    <div class="flex flex-wrap gap-1.5 mb-10" role="group" aria-label="Filter credentials">
      {categories.map((cat, i) => (
        <button type="button" data-category={cat} aria-pressed={i === 0 ? 'true' : 'false'} class="cred-filter-btn chip">{cat}</button>
      ))}
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {credentials.map((cred) => (
        <div class="cred-card-item" data-cred-category={cred.category}>
          <CredentialCard credential={cred} />
        </div>
      ))}
    </div>

    <div class="mt-14 fill-navy border-2 border-line p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div>
        <h2 class="h3">Want it all on one page?</h2>
        <p class="mt-2 opacity-90">The CV lists every certification with its issuer.</p>
      </div>
      <a href={dossier.resumePdfUrl} download="Robiul_Hasan_CV.pdf" class="btn btn-gold">Download CV <Icon name="download" /></a>
    </div>
  </section>

</BaseLayout>

<script>
  function setupCredsFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.cred-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.cred-card-item');

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        cards.forEach((card) => {
          card.hidden = !(cat === 'All' || card.dataset.credCategory === cat);
        });
      })
    );
  }

  document.addEventListener('astro:page-load', setupCredsFilter);
</script>
