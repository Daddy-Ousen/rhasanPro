---
// Dedicated Credentials Page: Certifications, Hackathons, Formal Degrees, and Language Proficiencies
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Certifications & Credentials — Robiul Hasan";
const pageDescription = "Verified certifications, Microsoft credentials (MD-102, MD-100), AMD AI Developer Hackathon achievements, Python and Linux foundations, and formal BBA degree of Robiul Hasan.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="max-w-4xl mx-auto px-6 py-12 lg:py-16 space-y-16">
    
    <!-- Page Header -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-500/10 text-amber-400 light:text-amber-700 border border-amber-500/20 text-xs font-mono font-medium">
        CREDENTIALS &bull; CERTIFICATIONS &bull; COMPETITIONS
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-white light:text-slate-950 tracking-tight leading-tight">
        Certifications, Hackathons & Education
      </h1>
      
      <p class="text-lg sm:text-xl text-slate-300 light:text-slate-700 leading-relaxed">
        Official Microsoft credentials, competitive AI hackathon certificates, technical foundation coursework, and academic qualifications.
      </p>
    </header>

    <!-- CREDENTIALS GRID -->
    <section class="space-y-8 pt-6 border-t border-slate-800 light:border-slate-200">
      
      <!-- Section 1: Professional Certifications -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white light:text-slate-950 tracking-tight">
          Industry Certifications & Hackathons
        </h2>

        <div class="grid sm:grid-cols-2 gap-4">
          
          <!-- MD-102 -->
          <div class="p-6 rounded-2xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-emerald-400 light:text-emerald-700 bg-emerald-500/10 light:bg-emerald-50 px-2 py-0.5 rounded border border-emerald-500/20 light:border-emerald-200 font-medium">
                Microsoft Certified
              </span>
              <a 
                href="https://learn.microsoft.com/api/credentials/share/en-us/RobiulHasan-1054/B1D8793EA1D57ED6?sharingId=D6FD17C973E7B1C5" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-xs font-mono text-emerald-400 light:text-emerald-600 hover:underline flex items-center gap-1 font-bold"
              >
                <span>Verify Credential &nearr;</span>
              </a>
            </div>
            <h3 class="text-base font-bold text-white light:text-slate-950">
              Microsoft 365 Certified: Endpoint Administrator Associate
            </h3>
            <p class="text-xs text-slate-400 light:text-slate-600 leading-relaxed">
              Exam MD-102 &bull; Validates expertise in deploying, configuring, securing, managing, and monitoring modern devices and client applications in enterprise Microsoft 365 environments.
            </p>
          </div>

          <!-- MD-100 -->
          <div class="p-6 rounded-2xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-emerald-400 light:text-emerald-700 bg-emerald-500/10 light:bg-emerald-50 px-2 py-0.5 rounded border border-emerald-500/20 light:border-emerald-200 font-medium">
                Microsoft Certified
              </span>
              <span class="text-xs font-mono text-slate-400 light:text-slate-500">Associate</span>
            </div>
            <h3 class="text-base font-bold text-white light:text-slate-950">
              Microsoft Certified: Modern Desktop Administrator Associate
            </h3>
            <p class="text-xs text-slate-400 light:text-slate-600 leading-relaxed">
              Exam MD-100 &bull; Validates core competencies in Windows OS deployment, local networking, file permissions, hardware troubleshooting, and identity integration.
            </p>
          </div>

          <!-- AMD AI Hackathon -->
          <div class="p-6 rounded-2xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-amber-400 light:text-amber-700 bg-amber-500/10 light:bg-amber-50 px-2 py-0.5 rounded border border-amber-500/20 light:border-amber-200 font-medium">
                Competitive Hackathon
              </span>
              <a 
                href="https://lablab.ai/u/@rhasan22959110/ai-hackathons/amd-developer-hackathon-act-ii/certificate" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-xs font-mono text-amber-400 light:text-amber-600 hover:underline flex items-center gap-1 font-bold"
              >
                <span>Verify Certificate &nearr;</span>
              </a>
            </div>
            <h3 class="text-base font-bold text-white light:text-slate-950">
              AMD AI Developer Hackathon &mdash; Act II
            </h3>
            <p class="text-xs text-slate-400 light:text-slate-600 leading-relaxed">
              Organized by lablab.ai and AMD AI. Built cutting-edge generative and agentic AI solutions utilizing advanced hardware acceleration and LLM tooling.
            </p>
          </div>

          <!-- Python Programming -->
          <div class="p-6 rounded-2xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-slate-400 light:text-slate-600 bg-slate-800 light:bg-slate-100 px-2 py-0.5 rounded">
                Specialized Coursework
              </span>
              <span class="text-xs font-mono text-slate-400 light:text-slate-500">2020</span>
            </div>
            <h3 class="text-base font-bold text-white light:text-slate-950">
              Python Programming Specialization
            </h3>
            <p class="text-xs text-slate-400 light:text-slate-600 leading-relaxed">
              University of Michigan (Coursera) &bull; Foundational data structures, scripting, web scraping, and automated API data processing in Python.
            </p>
          </div>

          <!-- Linux OS Foundation -->
          <div class="p-6 rounded-2xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-3 sm:col-span-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-slate-400 light:text-slate-600 bg-slate-800 light:bg-slate-100 px-2 py-0.5 rounded">
                Foundations
              </span>
              <span class="text-xs font-mono text-slate-400 light:text-slate-500">2021</span>
            </div>
            <h3 class="text-base font-bold text-white light:text-slate-950">
              Linux Operating System (Foundation)
            </h3>
            <p class="text-xs text-slate-400 light:text-slate-600 leading-relaxed">
              StudySection &bull; Core Linux shell administration, file permissions, process management, bash scripting, and daemon configuration.
            </p>
          </div>

        </div>
      </div>

      <!-- Section 2: Formal Education & Languages -->
      <div class="space-y-4 pt-6 border-t border-slate-800 light:border-slate-200">
        <h2 class="text-xl font-bold text-white light:text-slate-950 tracking-tight">
          Formal Education & Languages
        </h2>

        <div class="grid sm:grid-cols-2 gap-4">
          
          <div class="p-6 rounded-2xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-2">
            <div class="text-xs font-mono text-slate-400 light:text-slate-500">GRADUATED 2022 &bull; DHAKA, BANGLADESH</div>
            <h3 class="text-lg font-bold text-white light:text-slate-950">
              Bachelor of Business Administration (BBA)
            </h3>
            <p class="text-xs text-slate-300 light:text-slate-700">
              Bangladesh University of Professionals (BUP)
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-3">
            <div class="text-xs font-mono text-slate-400 light:text-slate-500 uppercase">Language Proficiencies</div>
            <div class="flex flex-wrap gap-2 pt-1">
              <span class="px-3 py-1.5 rounded-lg bg-slate-800 light:bg-slate-100 text-xs font-medium text-slate-200 light:text-slate-800 border border-slate-700 light:border-slate-300">
                Bengali &bull; Native
              </span>
              <span class="px-3 py-1.5 rounded-lg bg-slate-800 light:bg-slate-100 text-xs font-medium text-slate-200 light:text-slate-800 border border-slate-700 light:border-slate-300">
                English &bull; Fluent
              </span>
              <span class="px-3 py-1.5 rounded-lg bg-slate-800 light:bg-slate-100 text-xs font-medium text-slate-200 light:text-slate-800 border border-slate-700 light:border-slate-300">
                French &bull; Basic
              </span>
            </div>
          </div>

        </div>
      </div>

    </section>

  </main>

  <Footer />
</Layout>
