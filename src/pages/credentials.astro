---
import BaseLayout from '../layouts/BaseLayout.astro';
import CredentialTiltCard from '../components/CredentialTiltCard.astro';
import { credentials } from '../data/credentials';
import { dossier } from '../data/dossier';

const categories = ["All", "Microsoft Cloud", "AI & Hackathons", "Software & Linux"];
---

<BaseLayout
  title={`Verified Certifications & Credentials | ${dossier.name}`}
  description="Official Microsoft, AMD Hackathon, and Systems Engineering certifications earned by Robiul Hasan with live verification links."
>
  
  <div class="px-4 py-16 sm:py-24 max-w-6xl mx-auto space-y-12">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-mono mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
        <span>ACCREDITED INDUSTRY BADGES</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Verified Certifications & Accreditations
      </h1>
      <p class="text-slate-400 text-sm sm:text-base mt-4 leading-relaxed">
        Every credential listed below is verified by official issuing bodies including Microsoft Learn, AMD AI, and the University of Michigan.
      </p>
    </div>

    <!-- Category Filter Chips -->
    <div class="flex items-center justify-center gap-2 flex-wrap pb-4">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat}
          class={`cred-filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all ${
            idx === 0
              ? 'bg-amber-500/20 text-amber-400 border border-amber-500/40 font-semibold'
              : 'bg-slate-800/80 text-slate-400 hover:text-slate-200 border border-white/5'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Credentials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {credentials.map((cred) => (
        <div class="cred-card-item flex flex-col" data-cred-category={cred.category}>
          <CredentialTiltCard credential={cred} />
        </div>
      ))}
    </div>

    <!-- Security & Trust Verification Notice -->
    <div class="double-bezel-outer mt-8">
      <div class="double-bezel-inner p-8 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] text-slate-300 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center sm:text-left">
          <h4 class="text-sm font-bold text-white flex items-center gap-2">
            <span class="text-emerald-400">🔒</span>
            <span>Cryptographically Verifiable Credential Links</span>
          </h4>
          <p class="text-xs text-slate-400">
            Click any credential's "Verify" button to view the official digital transcript on Microsoft Learn and Lablab.ai.
          </p>
        </div>

        <a
          href={dossier.resumePdfUrl}
          download="Robiul_Hasan_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 transition-colors whitespace-nowrap"
        >
          Download CV with Credentials
        </a>
      </div>
    </div>

  </div>

</BaseLayout>

<script>
  function setupCredsFilter() {
    const filterBtns = document.querySelectorAll('.cred-filter-btn');
    const cards = document.querySelectorAll('.cred-card-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category');

        filterBtns.forEach((b) => {
          if (b === btn) {
            b.className = 'cred-filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all bg-amber-500/20 text-amber-400 border border-amber-500/40 font-semibold';
          } else {
            b.className = 'cred-filter-btn px-4 py-2 rounded-full text-xs font-mono font-medium transition-all bg-slate-800/80 text-slate-400 hover:text-slate-200 border border-white/5';
          }
        });

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-cred-category');
          if (cat === 'All' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupCredsFilter();
  document.addEventListener('astro:page-load', setupCredsFilter);
</script>
