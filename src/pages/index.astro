---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalSimulator from '../components/TerminalSimulator.astro';
import Icon from '../components/Icon.astro';
import { dossier } from '../data/dossier';
import { projects } from '../data/projects';
import { experiences } from '../data/experience';
import { credentials } from '../data/credentials';
import { metaFor, shortTitle, toneClass } from '../data/tones';

// Hermes leads as the full-width spotlight tile; the rest follow in a row of three.
const spotlightId = 'hermes-ai';
const featuredProjects = projects
  .filter((p) => p.featured)
  .slice(0, 4)
  .sort((a, b) => Number(b.id === spotlightId) - Number(a.id === spotlightId));

const stats = [
  { value: dossier.metrics.endpointsManaged, label: 'endpoints managed' },
  { value: dossier.metrics.edrProtected, label: 'EDR assets secured' },
  { value: dossier.metrics.projectsDelivered, label: 'IT projects delivered' },
  { value: dossier.metrics.csatRating, label: 'sustained CSAT' },
];

const tickerItems = [
  ['2,500+', 'ENDPOINTS'],
  ['1,100+', 'EDR ASSETS'],
  ['99.9%', 'BACKUPS GREEN'],
  ['90%+', 'CSAT'],
  ['135+', 'AI MODELS TRACKED'],
  ['25+', 'PROJECTS SHIPPED'],
];

const dayJobNotes: Record<string, string> = {
  'techants-solutions': 'L2 engineer and service desk co-lead. Intune, GravityZone, Datto. Tier-2 escalations for clients worldwide.',
  'cobait-dhaka': 'Jr. support engineer. 1,000+ tickets, Windows Server, AD and the first real backup drills.',
  aqsbd: 'IT executive. Wrote the SOPs, cabled the LAN, digitised the paperwork.',
};
---

<BaseLayout title={`${dossier.name} — ${dossier.role}`} description={dossier.shortBio}>

  <!-- HERO -->
  <section class="wrap pt-10 sm:pt-14 pb-16 grid gap-12 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-7">
      <p class="kicker inline-flex items-center gap-2 bg-ink text-paper px-2.5 py-1.5">
        <span class="led led-blink" aria-hidden="true"></span>Online in Dhaka · UTC+6
      </p>
      <h1 class="h1 mt-6 text-[clamp(48px,7.8vw,104px)]">
        I fix computers <span class="hl">for a living.</span> Then I teach them to <span class="text-pink">fix themselves.</span>
      </h1>
      <p class="mt-7 text-lg sm:text-xl leading-relaxed text-muted max-w-[48ch]">
        L2 systems engineer and service desk co-lead at an Australian MSP. 2,500 endpoints by day. By night: AI automation, model deployment and tuning, prompt engineering, and API setups.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projects" class="btn btn-teal">See what I built <Icon name="arrow" /></a>
        <a href={dossier.resumePdfUrl} download="Robiul_Hasan_CV.pdf" class="btn">Grab my CV <Icon name="download" /></a>
      </div>
      <a
        href="https://nextvector.rhasan.online/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-[15px] group"
      >
        <span class="kicker fill-pink px-2 py-1">New</span>
        <span class="link">NextVector — daily tech &amp; AI news, now live</span>
        <Icon name="external" class="w-4 h-4" />
      </a>
    </div>

    <div class="lg:col-span-5 flex justify-center">
      <div class="relative w-[min(82%,380px)]">
        <div class="aspect-square max-w-full fill-teal border-2 border-line shadow-[10px_10px_0_var(--pink)] overflow-hidden">
          <img
            src={dossier.avatarUrl}
            alt={`Pixel-art portrait of ${dossier.name}`}
            class="pixel-img w-full h-full mix-blend-multiply"
            width="380"
            height="380"
            loading="eager"
          />
        </div>
        <span class="kicker absolute -left-4 bottom-6 -rotate-6 fill-gold border-2 border-line px-2.5 py-2">MD-102<br />certified</span>
        <span class="kicker absolute -right-3 top-5 rotate-[5deg] bg-card text-ink border-2 border-line px-2.5 py-2">5+ yrs<br />in the MSP<br />trenches</span>
      </div>
    </div>
  </section>

  <!-- TICKER -->
  <div class="ticker bg-[#16161a] text-[#f5f4ef] border-y-2 border-line py-3 font-pixel text-sm" aria-hidden="true">
    <div class="ticker-track">
      {[...tickerItems, ...tickerItems].map(([n, l]) => (
        <span><span class="text-[#f2b31b]">{n}</span> {l}</span>
      ))}
    </div>
  </div>

  <!-- PROJECTS -->
  <section class="wrap py-16 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <p class="kicker text-muted">After hours</p>
        <h2 class="h2 mt-2">Stuff I built</h2>
      </div>
      <a href="/projects" class="link font-bold inline-flex items-center gap-2">All projects <Icon name="arrow" /></a>
    </div>

    <div class="grid gap-4 md:grid-cols-6">
      {featuredProjects.map((project) => {
        const meta = metaFor(project.id);
        if (project.id === spotlightId) {
          return (
            <article class={`${toneClass[meta.tone]} md:col-span-6 border-2 border-line lift grid lg:grid-cols-12`}>
              <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col gap-4">
                <p class="kicker opacity-90">Spotlight · {meta.tag}</p>
                <h3 class="h1 text-[clamp(48px,7vw,96px)]">
                  <a href={project.caseStudyUrl} class="hover:underline decoration-[4px] underline-offset-8">{shortTitle(project.title)}</a>
                </h3>
                <p class="text-lg sm:text-xl leading-relaxed max-w-[52ch]">{project.tagline}</p>
                <div class="mt-auto pt-2 flex flex-wrap gap-3">
                  <button type="button" data-open-hermes class="btn btn-teal">Ask Hermes now</button>
                  <a href={project.caseStudyUrl} class="btn">How it works <Icon name="arrow" /></a>
                </div>
              </div>
              <div class="lg:col-span-5 p-6 sm:p-8 grid gap-5 content-start border-t-2 lg:border-t-0 lg:border-l-2 border-line">
                <ul class="grid gap-3">
                  {project.subcards.map((sub) => (
                    <li class="border-2 border-line bg-card text-ink p-4">
                      <p class="font-bold">{sub.title}</p>
                      <p class="mt-1 text-[14px] leading-relaxed text-muted">{sub.description}</p>
                    </li>
                  ))}
                </ul>
                <dl class="pt-4 border-t-2 border-current grid grid-cols-3 gap-3">
                  {project.metrics.map((m) => (
                    <div>
                      <dt class="text-[13px] opacity-90">{m.label}</dt>
                      <dd class="font-display font-extrabold text-2xl leading-none tabular-nums">{m.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </article>
          );
        }
        return (
          <article class={`${toneClass[meta.tone]} md:col-span-2 border-2 border-line p-6 flex flex-col gap-3 min-h-[260px]`}>
            <p class="kicker opacity-90">{meta.tag}</p>
            <h3 class="h2">
              <a href={project.caseStudyUrl} class="hover:underline decoration-[3px] underline-offset-4">{shortTitle(project.title)}</a>
            </h3>
            <p class="text-[16px] leading-relaxed max-w-[50ch]">{meta.blurb}</p>
            <dl class="mt-auto pt-4 border-t-2 border-current flex flex-wrap gap-x-6 gap-y-2">
              {project.metrics.slice(0, 2).map((m) => (
                <div>
                  <dt class="text-[13px] opacity-90">{m.label}</dt>
                  <dd class="font-display font-extrabold text-2xl leading-none tabular-nums">{m.value}</dd>
                </div>
              ))}
            </dl>
          </article>
        );
      })}
    </div>
  </section>

  <!-- DAY JOB -->
  <section class="wrap pb-16 sm:pb-20">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <p class="kicker text-muted">9 to 5 (ish)</p>
        <h2 class="h2 mt-2">The day job</h2>
      </div>
      <a href="/experience" class="link font-bold inline-flex items-center gap-2">Full history <Icon name="arrow" /></a>
    </div>

    <dl class="grid grid-cols-2 lg:grid-cols-4 border-2 border-line bg-line gap-[2px] mb-6">
      {stats.map((s) => (
        <div class="bg-card p-5">
          <dd class="font-display font-extrabold text-[clamp(32px,4vw,48px)] leading-none tabular-nums">{s.value}</dd>
          <dt class="mt-2 text-[15px] text-muted">{s.label}</dt>
        </div>
      ))}
    </dl>

    <div class="grid md:grid-cols-3 border-2 border-line bg-line gap-[2px]">
      {experiences.map((exp) => (
        <div class="bg-card p-6 flex flex-col gap-2">
          <p class="kicker text-teal">{exp.period}</p>
          <h3 class="h3">{exp.company}</h3>
          <p class="text-[15px] leading-relaxed text-muted">{dayJobNotes[exp.id] ?? exp.summary}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- TERMINAL -->
  <section class="border-y-2 border-line bg-sunk">
    <div class="wrap py-16 sm:py-20 grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-4">
        <p class="kicker text-muted">Night shift</p>
        <h2 class="h2 mt-2">What a normal Tuesday looks like</h2>
        <p class="mt-4 text-[17px] leading-relaxed text-muted">
          Pick a command. It is a simulation, but the checks are the ones I really run: backup audits, Intune syncs, EDR sweeps.
        </p>
      </div>
      <div class="lg:col-span-8">
        <TerminalSimulator />
      </div>
    </div>
  </section>

  <!-- CREDENTIALS -->
  <section class="wrap pt-16 sm:pt-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="kicker text-muted">Paper trail</p>
        <h2 class="h2 mt-2">Certified, verified</h2>
      </div>
      <a href="/credentials" class="link font-bold inline-flex items-center gap-2">All credentials <Icon name="arrow" /></a>
    </div>
    <ul class="mt-8 flex flex-wrap gap-3">
      {credentials.map((c, i) => (
        <li class={`border-2 border-line px-3.5 py-2.5 font-bold ${i % 3 === 2 ? 'fill-gold' : 'bg-card'} ${i % 2 === 0 ? '-rotate-1' : 'rotate-1'}`}>
          <span class="font-pixel text-xs mr-2">{c.code}</span>{c.issuer}
        </li>
      ))}
      <li class="border-2 border-line px-3.5 py-2.5 font-bold fill-teal rotate-1">
        <span class="font-pixel text-xs mr-2">BBA</span>{dossier.education.institutionShort}
      </li>
    </ul>
  </section>

</BaseLayout>

<script>
  // "Ask Hermes now" on the spotlight tile opens the site-wide chat widget.
  function setupHermesSpotlight() {
    document.querySelectorAll<HTMLButtonElement>('[data-open-hermes]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const drawer = document.getElementById('hermes-chat-drawer');
        if (drawer?.hidden) document.getElementById('hermes-launcher-btn')?.click();
      })
    );
  }

  document.addEventListener('astro:page-load', setupHermesSpotlight);
</script>
