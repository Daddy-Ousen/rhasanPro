---
import BaseLayout from '../layouts/BaseLayout.astro';
import TelemetryBento from '../components/TelemetryBento.astro';
import TerminalSimulator from '../components/TerminalSimulator.astro';
import CredentialTiltCard from '../components/CredentialTiltCard.astro';
import { dossier } from '../data/dossier';
import { projects } from '../data/projects';
import { credentials } from '../data/credentials';
import DhakaClock from '../components/DhakaClock.astro';

const featuredProjects = projects.filter((p) => p.featured);
const featuredCredentials = credentials.slice(0, 3);
---

<BaseLayout
  title={`${dossier.name} — ${dossier.role}`}
  description={dossier.shortBio}
>
  
  <!-- HERO SECTION -->
  <section class="relative min-h-[85vh] flex flex-col justify-center items-center text-center px-4 pt-12 pb-20 max-w-6xl mx-auto">
    
    <!-- Operational Status Pill -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/90 border border-emerald-500/30 text-emerald-400 text-xs font-mono mb-8 shadow-[0_0_20px_rgba(16,185,129,0.15)] animate-fade-in">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span class="font-bold tracking-wider">{dossier.statusBadge}</span>
      <span class="text-slate-600">|</span>
      <span class="text-slate-400 font-mono">TECHANTS SOLUTIONS (MSP)</span>
    </div>

    <!-- Main Title & Headline -->
    <h1 class="hero-title text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white max-w-5xl leading-[1.1] mb-6">
      Engineering Resilient <br class="hidden sm:block" />
      <span class="bg-gradient-to-r from-amber-400 via-amber-200 to-amber-500 bg-clip-text text-transparent">
        Enterprise Infrastructure
      </span>
      <br class="hidden sm:block" />
      & Autonomous Systems
    </h1>

    <p class="hero-subtitle text-slate-300 text-sm sm:text-base md:text-lg max-w-2xl mx-auto leading-relaxed mb-10">
      Hi, I'm <strong class="text-white font-semibold">Robiul Hasan</strong>. L2 Systems Support Engineer and Service Desk Co-Leader managing 2,500+ endpoints, 1,100+ Bitdefender EDR assets, Datto BCDR appliances, and building agentic AI automations.
    </p>

    <!-- CTAs with Button-in-Button Micro-Interactions -->
    <div class="hero-cta flex flex-wrap items-center justify-center gap-4">
      
      <!-- Primary: Explore Projects -->
      <a
        href="/projects"
        class="group relative inline-flex items-center gap-3 px-6 py-3.5 rounded-full bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-xs sm:text-sm shadow-[0_0_25px_rgba(245,158,11,0.4)] transition-all hover:scale-105 active:scale-98"
      >
        <span>Explore Case Studies</span>
        <div class="w-7 h-7 rounded-full bg-slate-950/20 group-hover:bg-slate-950/30 flex items-center justify-center text-slate-950 transition-transform group-hover:translate-x-1">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>

      <!-- Secondary: Download Verified CV -->
      <a
        href={dossier.resumePdfUrl}
        download="Robiul_Hasan_CV.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 px-6 py-3.5 rounded-full bg-slate-900/90 hover:bg-slate-800 text-white font-semibold text-xs sm:text-sm border border-white/10 hover:border-amber-500/40 shadow-lg transition-all hover:scale-105 active:scale-98"
      >
        <span>Download Official CV</span>
        <div class="w-7 h-7 rounded-full bg-amber-500/20 flex items-center justify-center text-amber-400 group-hover:bg-amber-500/30 transition-transform group-hover:translate-y-0.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </div>
      </a>

      <!-- Tertiary: Contact / Dispatch -->
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-5 py-3.5 rounded-full text-xs sm:text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/5 transition-colors"
      >
        <span>Get in Touch</span>
        <span class="text-amber-400">→</span>
      </a>

    </div>

  </section>

  <!-- TELEMETRY & BENTO SECTION -->
  <section class="px-4 py-16 relative z-10">
    <TelemetryBento />
  </section>

  <!-- INTERACTIVE SIMULATED TERMINAL -->
  <section class="px-4 py-16 relative z-10 max-w-6xl mx-auto">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>INTERACTIVE MSP & DAEMON TERMINAL</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight">
        Simulated Infrastructure Automation
      </h2>
      <p class="text-slate-400 text-sm max-w-xl mx-auto mt-2">
        Execute simulated diagnostic scripts to inspect BCDR backups, sync Intune fleets, and trigger Bitdefender EDR scans.
      </p>
    </div>

    <TerminalSimulator />
  </section>

  <!-- FEATURED PROJECTS SHOWCASE -->
  <section class="px-4 py-20 relative z-10 max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          <span>AUTONOMOUS & WEB ARCHITECTURES</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight">
          Featured Engineering Case Studies
        </h2>
      </div>

      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-xs font-mono text-amber-400 hover:text-amber-300 font-semibold group"
      >
        <span>View all systems & projects</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <div class="space-y-8">
      {featuredProjects.map((project) => (
        <div class="double-bezel-outer">
          <div class="double-bezel-inner p-7 sm:p-9 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] light:bg-white space-y-6">
            
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
              <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-500/10 light:bg-amber-100 text-amber-400 light:text-amber-800 border border-amber-500/20 light:border-amber-300 text-xs font-medium font-mono">
                  {project.badge}
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-white light:text-slate-950 tracking-tight">
                  {project.title}
                </h3>
              </div>

              <div class="flex items-center gap-3 self-start">
                <a
                  href={project.caseStudyUrl}
                  class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition-all shadow-md flex items-center gap-1.5 whitespace-nowrap"
                >
                  <span>Read Case Study</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3.5 py-2 rounded-xl bg-slate-900/80 light:bg-slate-100 hover:bg-slate-800 light:hover:bg-slate-200 text-slate-200 light:text-slate-800 text-xs font-medium border border-white/10 light:border-slate-300 transition-colors flex items-center gap-1.5"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                    <span>GitHub</span>
                  </a>
                )}
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3.5 py-2 rounded-xl bg-slate-900/80 light:bg-slate-100 hover:bg-slate-800 light:hover:bg-slate-200 text-slate-200 light:text-slate-800 text-xs font-medium border border-white/10 light:border-slate-300 transition-colors flex items-center gap-1.5"
                  >
                    <span>Live Site</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                )}
              </div>
            </div>

            <p class="text-slate-300 light:text-slate-700 leading-relaxed text-sm sm:text-base">
              {project.overview}
            </p>

            {project.subcards && project.subcards.length > 0 && (
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
                {project.subcards.map((subcard) => (
                  <div class="p-4 rounded-xl bg-slate-950/60 light:bg-slate-50 border border-white/5 light:border-slate-200 space-y-1.5 shadow-sm">
                    <div class="font-bold text-white light:text-slate-900 text-xs sm:text-sm flex items-center gap-2">
                      <span class={`w-2 h-2 rounded-full ${
                        subcard.dotColor === 'amber' ? 'bg-amber-400 shadow-[0_0_6px_#f59e0b]' :
                        subcard.dotColor === 'emerald' ? 'bg-emerald-400 shadow-[0_0_6px_#10b981]' :
                        'bg-cyan-400 shadow-[0_0_6px_#06b6d4]'
                      }`}></span>
                      <span>{subcard.title}</span>
                    </div>
                    <p class="text-xs text-slate-400 light:text-slate-600 leading-relaxed">
                      {subcard.description}
                    </p>
                  </div>
                ))}
              </div>
            )}

          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- VERIFIED CREDENTIALS STRIP -->
  <section class="px-4 py-20 relative z-10 max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-mono mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
          <span>OFFICIAL CERTIFICATIONS & AWARDS</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight">
          Verified Credentials
        </h2>
      </div>

      <a
        href="/credentials"
        class="inline-flex items-center gap-2 text-xs font-mono text-amber-400 hover:text-amber-300 font-semibold group"
      >
        <span>View all credentials & badges</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredCredentials.map((cred) => (
        <CredentialTiltCard credential={cred} />
      ))}
    </div>
  </section>

</BaseLayout>
