---
// Dedicated Contact Page: Direct Communication, Email Copy, and Professional Social Connections
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Contact Robiul Hasan — IT Infrastructure & Systems Support Engineer";
const pageDescription = "Get in touch with Robiul Hasan for systems administration, cloud infrastructure, enterprise IT support, and automation engineering opportunities.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="max-w-4xl mx-auto px-6 py-12 lg:py-16 space-y-16">
    
    <!-- Page Header -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-500/10 text-amber-400 light:text-amber-700 border border-amber-500/20 text-xs font-mono font-medium">
        DIRECT COMMUNICATION &bull; HIRING MANAGERS & RECRUITERS
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-white light:text-slate-950 tracking-tight leading-tight">
        Let's Connect & Discuss Opportunities
      </h1>
      
      <p class="text-lg sm:text-xl text-slate-300 light:text-slate-700 leading-relaxed">
        I am currently exploring opportunities in Systems Administration, Enterprise Cloud Infrastructure, and Automation-Engineering.
      </p>
    </header>

    <!-- CONTACT CARDS -->
    <section class="space-y-8 pt-6 border-t border-slate-800 light:border-slate-200">
      
      <div class="p-8 sm:p-12 rounded-2xl bg-slate-900/60 light:bg-white border border-slate-800 light:border-slate-200 shadow-md space-y-8">
        
        <div class="space-y-3">
          <h2 class="text-2xl font-bold text-white light:text-slate-950">
            Direct Email Transmission
          </h2>
          <p class="text-sm text-slate-300 light:text-slate-700 leading-relaxed">
            Feel free to reach out directly regarding job opportunities, technical delivery, cloud migrations, or automation inquiries. I typically respond within 24 hours.
          </p>
        </div>

        <!-- Action Row -->
        <div class="flex flex-col sm:flex-row items-center gap-4">
          
          <!-- Copy Email Button -->
          <button 
            type="button" 
            data-copy-email="rhasan229@gmail.com" 
            class="w-full sm:w-auto px-6 py-3.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-amber-500/10 flex items-center justify-center gap-2 cursor-pointer active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span>Copy Email (rhasan229@gmail.com)</span>
          </button>

          <!-- Open mailto client -->
          <a 
            href="mailto:rhasan229@gmail.com" 
            class="w-full sm:w-auto px-6 py-3.5 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-white light:text-slate-900 border border-slate-700 light:border-slate-300 text-sm font-medium transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 text-amber-400 light:text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Open Email Client</span>
          </a>

          <!-- Download CV Button -->
          <a 
            href="/Robiul_Hasan_CV.pdf" 
            download 
            class="w-full sm:w-auto px-6 py-3.5 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-white light:text-slate-900 border border-slate-700 light:border-slate-300 text-sm font-medium transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 text-amber-400 light:text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span>Download CV</span>
          </a>

        </div>

        <!-- Social Channels & Location Grid -->
        <div class="grid sm:grid-cols-3 gap-4 pt-4 border-t border-slate-800 light:border-slate-200 text-xs font-mono">
          
          <a 
            href="https://linkedin.com/in/robiul-hasan-401296137" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-4 rounded-xl bg-slate-950/60 light:bg-slate-50 border border-slate-800 light:border-slate-200 hover:border-amber-400/50 transition-colors flex items-center justify-between group"
          >
            <div>
              <div class="text-slate-400 light:text-slate-500">Professional Network</div>
              <div class="font-bold text-white light:text-slate-900 group-hover:text-amber-400 transition-colors">LinkedIn Profile</div>
            </div>
            <span class="text-amber-400 light:text-amber-600">&nearr;</span>
          </a>

          <a 
            href="https://github.com/Daddy-Ousen" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-4 rounded-xl bg-slate-950/60 light:bg-slate-50 border border-slate-800 light:border-slate-200 hover:border-amber-400/50 transition-colors flex items-center justify-between group"
          >
            <div>
              <div class="text-slate-400 light:text-slate-500">Code & Projects</div>
              <div class="font-bold text-white light:text-slate-900 group-hover:text-amber-400 transition-colors">GitHub Repositories</div>
            </div>
            <span class="text-amber-400 light:text-amber-600">&nearr;</span>
          </a>

          <div class="p-4 rounded-xl bg-slate-950/60 light:bg-slate-50 border border-slate-800 light:border-slate-200 flex items-center justify-between">
            <div>
              <div class="text-slate-400 light:text-slate-500">Location</div>
              <div class="font-bold text-white light:text-slate-900">Dhaka, Bangladesh</div>
            </div>
            <span class="text-emerald-400 light:text-emerald-600 font-mono">[UTC+6]</span>
          </div>

        </div>

      </div>

    </section>

  </main>

  <Footer />
</Layout>
