---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import DhakaClock from '../components/DhakaClock.astro';
import Icon from '../components/Icon.astro';
import { dossier } from '../data/dossier';

const channels = [
  { label: 'WhatsApp', value: dossier.phone, href: dossier.whatsappUrl, icon: 'whatsapp', tone: 'fill-teal', external: true },
  { label: 'Email', value: dossier.email, href: `mailto:${dossier.email}`, icon: 'mail', tone: 'fill-gold', external: false },
  { label: 'LinkedIn', value: 'robiul-hasan', href: dossier.linkedin, icon: 'linkedin', tone: 'fill-navy', external: true },
  { label: 'GitHub', value: 'Daddy-Ousen', href: dossier.github, icon: 'github', tone: 'fill-pink', external: true },
] as const;
---

<BaseLayout
  title={`Contact | ${dossier.name}`}
  description="Contact Robiul Hasan on WhatsApp (+8801843212123) or email about infrastructure work, M365 migrations, or service desk and sysadmin roles."
  hideFooterCta
>

  <PageHeader
    kicker="Contact"
    intro="Infrastructure help, a migration, or a role on your team. I usually reply within a day, Dhaka time."
  >
    Say <span class="hl">hi.</span>
  </PageHeader>

  <section class="wrap py-16 grid gap-10 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-5 grid gap-6">
      <ul class="box lift divide-y-2 divide-line">
        {channels.map((c) => (
          <li>
            <a
              href={c.href}
              {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="flex items-center gap-4 p-4 hover:bg-sunk group"
            >
              <span class={`${c.tone} w-11 h-11 shrink-0 border-2 border-line grid place-items-center`}>
                <Icon name={c.icon} class="w-5 h-5" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="kicker text-muted block">{c.label}</span>
                <span class="font-bold text-[17px] block truncate">{c.value}</span>
              </span>
              <Icon name="arrow" class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>

      <div class="box p-5 flex flex-wrap items-center justify-between gap-3">
        <span class="text-muted">My local time</span>
        <DhakaClock class="text-[15px]" />
      </div>
    </div>

    <div class="lg:col-span-7 box lift p-6 sm:p-8">
      <p class="kicker text-teal">Opens WhatsApp with your note filled in</p>
      <h2 class="h2 mt-2">Write me a note</h2>

      <form id="contact-form" class="mt-8 grid gap-5" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="contact-name" class="label">Your name</label>
            <input id="contact-name" type="text" class="field" required autocomplete="name" placeholder="Alex Morgan" />
          </div>
          <div>
            <label for="contact-email" class="label">Your email</label>
            <input id="contact-email" type="email" class="field" required autocomplete="email" placeholder="alex@company.com" />
          </div>
        </div>
        <div>
          <label for="contact-subject" class="label">What is it about?</label>
          <input id="contact-subject" type="text" class="field" required placeholder="M365 migration, sysadmin role…" />
        </div>
        <div>
          <label for="contact-message" class="label">Message</label>
          <textarea id="contact-message" rows="6" class="field leading-relaxed" required placeholder="A little about your environment or the role."></textarea>
        </div>

        <button id="contact-submit-btn" type="submit" class="btn btn-teal w-full">
          <Icon name="whatsapp" class="w-5 h-5" /> Send on WhatsApp
        </button>

        <p id="contact-feedback-msg" class="border-2 p-3 font-bold" role="status" hidden></p>
      </form>
    </div>
  </section>

</BaseLayout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const feedback = document.getElementById('contact-feedback-msg');
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    if (!form || !feedback) return;

    const value = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value.trim() || '';

    const show = (message: string, ok: boolean) => {
      feedback.textContent = message;
      feedback.className = ok
        ? 'border-2 border-line p-3 font-bold fill-teal'
        : 'border-2 border-pink p-3 font-bold text-pink bg-card';
      feedback.hidden = false;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = value('contact-name');
      const email = value('contact-email');
      const subject = value('contact-subject');
      const message = value('contact-message');

      if (!name || !email || !subject || !message) {
        show('Fill in all four fields, then send again.', false);
        return;
      }

      if (submitBtn) submitBtn.disabled = true;

      const text = `*New note from rhasan.online*\n\n*From:* ${name}\n*Email:* ${email}\n*Subject:* ${subject}\n\n${message}`;
      const url = `https://wa.me/8801843212123?text=${encodeURIComponent(text)}`;

      show('Opening WhatsApp with your note…', true);

      setTimeout(() => {
        const opened = window.open(url, '_blank');
        if (!opened || opened.closed || typeof opened.closed === 'undefined') {
          window.location.href = url;
        }
        if (submitBtn) submitBtn.disabled = false;
      }, 400);
    });
  }

  document.addEventListener('astro:page-load', setupContactForm);
</script>
