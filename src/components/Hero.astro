---
// Hero Component: Impactful Headline, Telemetry Metrics, and Core Actions
---

<section class="space-y-8 pt-4">
  
  <!-- Live Operational Status Indicator -->
  <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900/80 light:bg-slate-100 border border-slate-800 light:border-slate-300 text-xs text-slate-300 light:text-slate-700 shadow-sm">
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
    <span class="font-medium">Available for Systems Administration & Cloud Infrastructure Roles</span>
  </div>

  <!-- Primary Headline & Positioning -->
  <div class="space-y-4 max-w-4xl">
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white light:text-slate-950 leading-[1.1]">
      Keeping enterprise systems reliable, compliant, and automated.
    </h1>
    <p class="text-lg sm:text-xl text-slate-300 light:text-slate-700 leading-relaxed font-normal">
      <strong class="text-white light:text-slate-950 font-semibold">IT Support Engineer L2 & Service Desk Co-Leader</strong> with 5+ years managing 2,500+ endpoints, Microsoft 365 & Azure environments, and quarterly disaster recovery. Building agentic AI tooling to eliminate operational toil.
    </p>
  </div>

  <!-- Telemetry Metrics HUD -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-2">
    
    <div class="p-5 rounded-xl bg-slate-900/60 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-1">
      <div class="text-3xl sm:text-4xl font-bold font-mono text-white light:text-slate-900">2,500+</div>
      <div class="text-xs text-slate-400 light:text-slate-600 font-medium">Endpoints Managed</div>
    </div>

    <div class="p-5 rounded-xl bg-slate-900/60 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-1">
      <div class="text-3xl sm:text-4xl font-bold font-mono text-white light:text-slate-900">1,100+</div>
      <div class="text-xs text-slate-400 light:text-slate-600 font-medium">Security Assets Administered</div>
    </div>

    <div class="p-5 rounded-xl bg-slate-900/60 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-1">
      <div class="text-3xl sm:text-4xl font-bold font-mono text-white light:text-slate-900">25+</div>
      <div class="text-xs text-slate-400 light:text-slate-600 font-medium">Enterprise Projects Delivered</div>
    </div>

    <div class="p-5 rounded-xl bg-slate-900/60 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-1">
      <div class="text-3xl sm:text-4xl font-bold font-mono text-emerald-400 light:text-emerald-600">&gt;90%</div>
      <div class="text-xs text-slate-400 light:text-slate-600 font-medium">Customer Satisfaction (CSAT)</div>
    </div>

  </div>

  <!-- Primary CTAs & Outbound Links -->
  <div class="flex flex-wrap items-center gap-4 pt-2">
    <a 
      href="#contact" 
      class="px-6 py-3 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-amber-500/10"
    >
      Get in Touch
    </a>
    
    <a 
      href="#experience" 
      class="px-5 py-3 rounded-lg bg-slate-900 light:bg-white hover:bg-slate-800 light:hover:bg-slate-50 text-slate-200 light:text-slate-800 border border-slate-800 light:border-slate-300 text-sm font-medium transition-colors"
    >
      View Work History &darr;
    </a>

    <div class="flex items-center gap-4 ml-auto text-slate-400 light:text-slate-600 text-sm">
      <a 
        href="https://linkedin.com/in/robiul-hasan-401296137" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hover:text-white light:hover:text-black transition-colors flex items-center gap-1.5"
      >
        <span>LinkedIn</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
      <span>&bull;</span>
      <a 
        href="https://github.com/Daddy-Ousen" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hover:text-white light:hover:text-black transition-colors flex items-center gap-1.5"
      >
        <span>GitHub</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>
  </div>

</section>
