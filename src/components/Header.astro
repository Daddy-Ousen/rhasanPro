---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { dossier } from '../data/dossier';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Experience', href: '/experience' },
  { name: 'Skills', href: '/skills' },
  { name: 'Projects', href: '/projects' },
  { name: 'Credentials', href: '/credentials' },
  { name: 'Contact', href: '/contact' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 bg-paper border-b-2 border-line">
  <div class="wrap h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${dossier.name}, home`}>
      <img
        src={dossier.avatarUrl}
        alt=""
        class="pixel-img w-9 h-9 border-2 border-line bg-teal"
        width="36"
        height="36"
        loading="eager"
      />
      <span class="font-pixel text-[15px] leading-none">ROBIUL.HASAN</span>
    </a>

    <nav class="hidden xl:flex items-center gap-1.5" aria-label="Main">
      {navLinks.map((link) => (
        <a href={link.href} class="chip" aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5">
      <a
        href="https://nextvector.rhasan.online/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden 2xl:inline-flex chip"
      >
        NextVector <Icon name="external" class="w-3.5 h-3.5" />
      </a>
      <ThemeToggle />
      <a
        href={dossier.resumePdfUrl}
        download="Robiul_Hasan_CV.pdf"
        class="hidden sm:inline-flex btn btn-sm btn-gold"
      >
        CV <Icon name="download" class="w-3.5 h-3.5" />
      </a>
      <button
        id="mobile-menu-btn"
        type="button"
        class="xl:hidden btn btn-sm"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        Menu
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="xl:hidden border-t-2 border-line bg-paper" aria-label="Main" hidden>
    <div class="wrap py-6 grid gap-6 sm:grid-cols-2">
      <ul class="grid gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`h3 flex items-center justify-between py-1.5 ${isActive(link.href) ? 'text-pink' : ''}`}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.name}
              {isActive(link.href) && <span class="led" aria-hidden="true"></span>}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex flex-col gap-3 sm:justify-end">
        <a href="https://nextvector.rhasan.online/" target="_blank" rel="noopener noreferrer" class="btn">
          NextVector <Icon name="external" />
        </a>
        <a href={dossier.resumePdfUrl} download="Robiul_Hasan_CV.pdf" class="btn btn-gold">
          Download CV <Icon name="download" />
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;

    const setOpen = (open: boolean) => {
      nav.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Close' : 'Menu';
    };

    btn.addEventListener('click', () => setOpen(nav.hidden));
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !nav.hidden) setOpen(false);
    });
  }

  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
