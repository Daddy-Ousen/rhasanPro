---
// Opening block for inner pages. Default slot = the h1 content (may include <span class="hl">).
interface Props {
  kicker: string;
  intro?: string;
}

const { kicker, intro } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="border-b-2 border-line">
  <div class={`wrap pt-12 sm:pt-16 pb-12 grid gap-10 ${hasAside ? 'lg:grid-cols-12 lg:items-end' : ''}`}>
    <div class={hasAside ? 'lg:col-span-8' : 'max-w-4xl'}>
      <p class="kicker inline-flex items-center gap-2 bg-ink text-paper px-2.5 py-1.5">
        <span class="led" aria-hidden="true"></span>{kicker}
      </p>
      <h1 class="h1 mt-5"><slot /></h1>
      {intro && <p class="mt-6 text-lg leading-relaxed text-muted max-w-[60ch]">{intro}</p>}
    </div>
    {hasAside && <div class="lg:col-span-4"><slot name="aside" /></div>}
  </div>
</section>
