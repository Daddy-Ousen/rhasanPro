---
import { dossier } from '../data/dossier';
---

<div class="w-full max-w-6xl mx-auto">
  <div class="text-center mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
      <span>FLEET TELEMETRY & METRICS</span>
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight">
      Quantified Operational Impact
    </h2>
    <p class="text-slate-400 text-sm max-w-xl mx-auto mt-2">
      Real metrics from 5+ years managing enterprise MSP endpoints, EDR security meshes, and high-availability BCDR appliances.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    
    <!-- Bento Card 1: Endpoints Managed -->
    <div class="telemetry-card double-bezel-outer group">
      <div class="double-bezel-inner p-6 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] h-full flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -right-8 -top-8 w-28 h-28 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>
        
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="p-2.5 rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </span>
            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider">Active Fleet</span>
          </div>

          <div class="flex items-baseline gap-1">
            <span class="text-3xl sm:text-4xl font-extrabold font-mono text-white counter-number" data-target="2500">0</span>
            <span class="text-2xl font-bold font-mono text-blue-400">+</span>
          </div>
          <h3 class="text-sm font-semibold text-slate-200 mt-2">Endpoints Managed Monthly</h3>
        </div>

        <p class="text-xs text-slate-400 mt-4 leading-relaxed border-t border-white/5 pt-3">
          Automated patching, Intune compliance, Autopilot zero-touch deployments, and configuration drift monitoring.
        </p>
      </div>
    </div>

    <!-- Bento Card 2: EDR Security -->
    <div class="telemetry-card double-bezel-outer group">
      <div class="double-bezel-inner p-6 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] h-full flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -right-8 -top-8 w-28 h-28 bg-red-500/10 rounded-full blur-2xl pointer-events-none"></div>
        
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="p-2.5 rounded-xl bg-red-500/10 text-red-400 border border-red-500/20">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </span>
            <span class="text-[10px] font-mono text-emerald-400 uppercase tracking-wider flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              EDR Active
            </span>
          </div>

          <div class="flex items-baseline gap-1">
            <span class="text-3xl sm:text-4xl font-extrabold font-mono text-white counter-number" data-target="1100">0</span>
            <span class="text-2xl font-bold font-mono text-red-400">+</span>
          </div>
          <h3 class="text-sm font-semibold text-slate-200 mt-2">Bitdefender EDR Assets</h3>
        </div>

        <p class="text-xs text-slate-400 mt-4 leading-relaxed border-t border-white/5 pt-3">
          GravityZone endpoint detection and response, real-time threat hunting, and anti-phishing defense.
        </p>
      </div>
    </div>

    <!-- Bento Card 3: Enterprise Projects -->
    <div class="telemetry-card double-bezel-outer group">
      <div class="double-bezel-inner p-6 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] h-full flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -right-8 -top-8 w-28 h-28 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>
        
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="p-2.5 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </span>
            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider">Completed</span>
          </div>

          <div class="flex items-baseline gap-1">
            <span class="text-3xl sm:text-4xl font-extrabold font-mono text-white counter-number" data-target="25">0</span>
            <span class="text-2xl font-bold font-mono text-amber-400">+</span>
          </div>
          <h3 class="text-sm font-semibold text-slate-200 mt-2">Enterprise IT Projects</h3>
        </div>

        <p class="text-xs text-slate-400 mt-4 leading-relaxed border-t border-white/5 pt-3">
          Including 5 large enterprise rollouts, cloud migrations, Datto BCDR installations, and Active Directory overhauls.
        </p>
      </div>
    </div>

    <!-- Bento Card 4: CSAT Rating with Circular Gauge -->
    <div class="telemetry-card double-bezel-outer group">
      <div class="double-bezel-inner p-6 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] h-full flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -right-8 -top-8 w-28 h-28 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>
        
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
              </svg>
            </span>

            <!-- SVG Circular Gauge -->
            <div class="relative w-12 h-12 flex items-center justify-center">
              <svg class="w-12 h-12 transform -rotate-90" viewBox="0 0 36 36">
                <path
                  class="text-slate-800"
                  stroke-width="3.5"
                  stroke="currentColor"
                  fill="none"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                />
                <path
                  id="csat-gauge-stroke"
                  class="text-emerald-400 transition-all duration-1000 ease-out"
                  stroke-dasharray="0, 100"
                  stroke-width="3.5"
                  stroke-linecap="round"
                  stroke="currentColor"
                  fill="none"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                />
              </svg>
              <span class="absolute text-[10px] font-mono font-bold text-emerald-400">94%</span>
            </div>
          </div>

          <div class="flex items-baseline gap-1">
            <span class="text-3xl sm:text-4xl font-extrabold font-mono text-white counter-number" data-target="90">0</span>
            <span class="text-2xl font-bold font-mono text-emerald-400">%+</span>
          </div>
          <h3 class="text-sm font-semibold text-slate-200 mt-2">Sustained CSAT SLA</h3>
        </div>

        <p class="text-xs text-slate-400 mt-4 leading-relaxed border-t border-white/5 pt-3">
          Co-leading a 10+ member service desk with rapid Tier-2 escalation resolution and strict SLA adherence.
        </p>
      </div>
    </div>

  </div>
</div>

<script>
  function setupTelemetryCounters() {
    const cards = document.querySelectorAll('.telemetry-card');
    const counters = document.querySelectorAll('.counter-number');
    const csatGauge = document.getElementById('csat-gauge-stroke');

    // Mouse follow spotlight effect on cards
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e: Event) => {
        const mouseEvent = e as MouseEvent;
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      });
    });

    // Count-up numbers on intersection
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            counters.forEach((counter) => {
              const target = parseInt(counter.getAttribute('data-target') || '0', 10);
              const duration = 1500;
              const startTime = performance.now();

              function updateCount(now: number) {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                // Ease-out expo
                const current = Math.floor(target * (progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress)));
                counter.textContent = current.toLocaleString();

                if (progress < 1) {
                  requestAnimationFrame(updateCount);
                } else {
                  counter.textContent = target.toLocaleString();
                }
              }

              requestAnimationFrame(updateCount);
            });

            // Animate CSAT stroke
            if (csatGauge) {
              csatGauge.setAttribute('stroke-dasharray', '94, 100');
            }

            observer.disconnect();
          }
        });
      },
      { threshold: 0.2 }
    );

    const container = document.querySelector('.telemetry-card');
    if (container) observer.observe(container);
  }

  setupTelemetryCounters();
  document.addEventListener('astro:page-load', setupTelemetryCounters);
</script>
