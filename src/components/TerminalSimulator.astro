---
// TerminalSimulator.astro — scripted MSP checks. Always dark, in both themes.
const tabs = [
  { key: 'audit', label: 'audit-bcdr' },
  { key: 'intune', label: 'intune-sync' },
  { key: 'edr', label: 'edr-scan' },
  { key: 'telemetry', label: 'status' },
];
---

<div class="border-2 border-line lift bg-[#16161a] text-[#e8e6df]">
  <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 border-b-2 border-[#3a3a42] bg-[#1f1f25]">
    <span class="font-pixel text-xs text-[#f2b31b]">rhasan@msp-core:~$</span>
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Choose a command">
      {tabs.map((t, i) => (
        <button
          type="button"
          data-cmd={t.key}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="terminal-tab font-mono text-xs px-2.5 py-1 border-[1.5px] border-[#5a5a63] text-[#c9c7c0] hover:border-[#f2b31b] hover:text-[#f2b31b] aria-pressed:bg-[#f2b31b] aria-pressed:border-[#f2b31b] aria-pressed:text-[#16161a] cursor-pointer"
        >
          {t.label}
        </button>
      ))}
    </div>
  </div>

  <div class="p-4 sm:p-6 font-mono text-[13px] leading-relaxed min-h-[280px] max-h-[380px] overflow-y-auto" aria-live="polite">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-[#5fd3b5] font-semibold">➜</span>
      <span id="terminal-cmd-text" class="text-[#f2b31b] font-semibold break-all">hermes run --audit-bcdr --target=fleet-appliances</span>
      <span class="inline-block w-2 h-4 bg-[#f2b31b] led-blink" aria-hidden="true"></span>
    </div>
    <div id="terminal-stdout" class="mt-3 space-y-1"></div>
  </div>

  <div class="flex justify-between gap-3 px-4 py-2 border-t-2 border-[#3a3a42] font-pixel text-[11px] text-[#8e8d88]">
    <span>SIMULATED OUTPUT</span>
    <span>HERMES-CORE v2.4</span>
  </div>
</div>

<script>
  type LineType = 'info' | 'success' | 'warn' | 'summary' | 'head';

  const commands: Record<string, { cmd: string; lines: { text: string; type: LineType }[] }> = {
    audit: {
      cmd: 'hermes run --audit-bcdr --target=fleet-appliances',
      lines: [
        { text: '[INIT] Contacting Datto SIRIS & Acronis BCDR orchestrator...', type: 'info' },
        { text: '[VERIFY] Probing 38 backup appliances across client tenants...', type: 'info' },
        { text: '  ├─ Datto SIRIS-4 (Tenant-AUS): screenshot verification PASSED [RTO < 6m]', type: 'success' },
        { text: '  ├─ Acronis cloud storage: immutable copy VALIDATED', type: 'success' },
        { text: '  ├─ Local standby drill: Hyper-V snapshot booted cleanly', type: 'success' },
        { text: '[SDO AUDIT] Compliance 100% | RPO < 15 min | NOMINAL', type: 'summary' },
      ],
    },
    intune: {
      cmd: 'intune-cli sync-devices --tenant=m365-production --compliance=strict',
      lines: [
        { text: '[ENTRA ID] Authenticating with certificate-based service principal...', type: 'info' },
        { text: '[INTUNE] Fetching device state for 2,500+ endpoints...', type: 'info' },
        { text: '  ├─ Windows 11 Autopilot fleet: 1,840 devices [baseline 100%]', type: 'success' },
        { text: '  ├─ macOS & iOS profiles: 660 devices [compliant, FileVault on]', type: 'success' },
        { text: '  ├─ BitLocker keys escrowed to Entra: 100%', type: 'success' },
        { text: '[SYNC COMPLETE] 0 non-compliant devices.', type: 'summary' },
      ],
    },
    edr: {
      cmd: 'bitdefender-edr --scan-fleet --telemetry=realtime',
      lines: [
        { text: '[GRAVITYZONE] Connecting to Bitdefender cloud console...', type: 'info' },
        { text: '[SENSOR] Telemetry active on 1,100+ EDR endpoints...', type: 'info' },
        { text: '  ├─ Ransomware signatures: none active', type: 'success' },
        { text: '  ├─ Anti-phishing: 47 suspicious inbound payloads blocked today', type: 'warn' },
        { text: '  ├─ Patch Tuesday remediation: 99.4% fleet coverage', type: 'success' },
        { text: '[STATUS] 0 critical alerts.', type: 'summary' },
      ],
    },
    telemetry: {
      cmd: 'systemctl status msp-service-desk',
      lines: [
        { text: '● msp-service-desk.service — Robiul Hasan, L2 co-lead', type: 'head' },
        { text: '   Loaded: loaded (/etc/systemd/system/msp-core.service; enabled)', type: 'info' },
        { text: '   Active: active (running) since Oct 2022', type: 'success' },
        { text: '   Metrics: CSAT > 90% | 25+ projects delivered', type: 'summary' },
        { text: '   Team: 10+ engineers co-led | SLA adherence 99.1%', type: 'success' },
        { text: '   Status: open to sysadmin & cloud infrastructure roles', type: 'head' },
      ],
    },
  };

  const colors: Record<LineType, string> = {
    info: 'text-[#c9c7c0]',
    success: 'text-[#5fd3b5]',
    warn: 'text-[#f2b31b]',
    summary: 'text-[#f59bb9] font-semibold',
    head: 'text-white font-semibold',
  };

  function setupTerminalSimulator() {
    const cmdText = document.getElementById('terminal-cmd-text');
    const stdout = document.getElementById('terminal-stdout');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.terminal-tab');
    if (!cmdText || !stdout) return;

    let timers: ReturnType<typeof setTimeout>[] = [];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function render(key: string, animate: boolean) {
      timers.forEach(clearTimeout);
      timers = [];
      const target = commands[key];
      if (!target || !cmdText || !stdout) return;

      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.cmd === key)));
      cmdText.textContent = target.cmd;
      stdout.innerHTML = '';

      target.lines.forEach((line, i) => {
        const add = () => {
          const row = document.createElement('div');
          row.className = colors[line.type];
          row.textContent = line.text;
          stdout.appendChild(row);
        };
        if (animate && !reduced) timers.push(setTimeout(add, (i + 1) * 150));
        else add();
      });
    }

    tabs.forEach((t) => t.addEventListener('click', () => render(t.dataset.cmd || 'audit', true)));
    render('audit', false);
    document.addEventListener('astro:before-swap', () => timers.forEach(clearTimeout), { once: true });
  }

  document.addEventListener('astro:page-load', setupTerminalSimulator);
</script>
