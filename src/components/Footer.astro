---
import { dossier } from '../data/dossier';
import DhakaClock from './DhakaClock.astro';

const currentYear = new Date().getFullYear();
---

<footer class="w-full mt-24 pb-12 px-4 max-w-6xl mx-auto">
  <div class="double-bezel-outer">
    <div class="double-bezel-inner p-8 sm:p-12 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] text-slate-300">
      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-10 border-b border-white/10">
        
        <!-- Left: Identity & Status -->
        <div class="md:col-span-5 flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center font-mono font-bold text-slate-950 text-sm shadow-[0_0_15px_rgba(245,158,11,0.4)]">
              RH
            </div>
            <div>
              <h3 class="text-base font-bold text-white tracking-tight">{dossier.name}</h3>
              <p class="text-xs text-slate-400 font-mono">{dossier.role}</p>
            </div>
          </div>

          <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
            {dossier.shortBio}
          </p>

          <div class="pt-1">
            <DhakaClock />
          </div>
        </div>

        <!-- Center: Quick Links -->
        <div class="md:col-span-3 flex flex-col gap-3">
          <h4 class="text-xs font-mono uppercase tracking-widest text-amber-400 font-semibold">Architecture</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/" class="text-slate-400 hover:text-white transition-colors">01. Overview & Terminal</a></li>
            <li><a href="/about" class="text-slate-400 hover:text-white transition-colors">02. Bio & Leadership</a></li>
            <li><a href="/experience" class="text-slate-400 hover:text-white transition-colors">03. Verified Experience</a></li>
            <li><a href="/skills" class="text-slate-400 hover:text-white transition-colors">04. 6-Domain Skill Radar</a></li>
            <li><a href="/projects" class="text-slate-400 hover:text-white transition-colors">05. Case Studies & AI</a></li>
            <li><a href="/credentials" class="text-slate-400 hover:text-white transition-colors">06. Microsoft & Hackathon Badges</a></li>
            <li><a href="/contact" class="text-slate-400 hover:text-white transition-colors">07. Contact & Dispatch</a></li>
          </ul>
        </div>

        <!-- Right: Verified Channels -->
        <div class="md:col-span-4 flex flex-col gap-3">
          <h4 class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-semibold">Direct Communication</h4>
          
          <div class="flex flex-col gap-2 text-xs">
            <a
              href={`mailto:${dossier.email}`}
              class="flex items-center gap-2.5 p-2.5 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-white/5 hover:border-amber-500/30 text-slate-300 hover:text-amber-400 transition-all group"
            >
              <span class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400 group-hover:scale-110 transition-transform">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </span>
              <span class="font-mono truncate">{dossier.email}</span>
            </a>

            <a
              href={dossier.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 p-2.5 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-white/5 hover:border-blue-500/30 text-slate-300 hover:text-blue-400 transition-all group"
            >
              <span class="p-1.5 rounded-lg bg-blue-500/10 text-blue-400 group-hover:scale-110 transition-transform">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.88 0-1.6.72-1.6 1.6 0 .88.72 1.6 1.6 1.6.88 0 1.6-.72 1.6-1.6 0-.88-.72-1.6-1.6-1.6Z"/>
                </svg>
              </span>
              <span class="font-mono">linkedin.com/in/robiul-hasan</span>
            </a>

            <a
              href={dossier.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 p-2.5 rounded-xl bg-slate-900/60 hover:bg-slate-800/80 border border-white/5 hover:border-purple-500/30 text-slate-300 hover:text-purple-400 transition-all group"
            >
              <span class="p-1.5 rounded-lg bg-purple-500/10 text-purple-400 group-hover:scale-110 transition-transform">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
              </span>
              <span class="font-mono">github.com/Daddy-Ousen</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Bottom Bar -->
      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <div class="flex items-center gap-2">
          <span>&copy; {currentYear} {dossier.name}. All Rights Reserved.</span>
          <span>&bull;</span>
          <span class="text-amber-500/80 font-mono">rhasan.online / rhasan.pro</span>
        </div>

        <div class="flex items-center gap-4 text-slate-400">
          <span class="font-mono text-[11px] px-2.5 py-1 rounded bg-slate-900 border border-white/5 text-emerald-400">
            Astro 5 &bull; Lenis &bull; GSAP &bull; Fireworks AI
          </span>
        </div>
      </div>

    </div>
  </div>
</footer>
