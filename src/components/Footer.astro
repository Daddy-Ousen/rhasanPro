---
import { dossier } from '../data/dossier';
import DhakaClock from './DhakaClock.astro';
import Icon from './Icon.astro';

interface Props {
  hideCta?: boolean;
}

const { hideCta = false } = Astro.props;
const currentYear = new Date().getFullYear();

const siteLinks = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Experience', href: '/experience' },
  { name: 'Skills', href: '/skills' },
  { name: 'Projects', href: '/projects' },
  { name: 'Credentials', href: '/credentials' },
  { name: 'Contact', href: '/contact' },
];

const channels = [
  { label: 'Email', value: dossier.email, href: `mailto:${dossier.email}`, external: false },
  { label: 'WhatsApp', value: '+880 1843 212123', href: dossier.whatsappUrl, external: true },
  { label: 'GitHub', value: 'Daddy-Ousen', href: dossier.github, external: true },
  { label: 'LinkedIn', value: 'robiul-hasan', href: dossier.linkedin, external: true },
];
---

{!hideCta && (
  <section class="fill-teal border-t-2 border-line mt-24">
    <div class="wrap py-14 sm:py-20 grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker opacity-90">Open to sysadmin &amp; cloud infra roles</p>
        <h2 class="h1 mt-4">Got a messy network? I like those.</h2>
      </div>
      <ul class="lg:col-span-5 grid gap-3">
        {channels.map((c) => (
          <li>
            <a
              href={c.href}
              {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="flex items-baseline justify-between gap-4 border-b-2 border-white/50 hover:border-white pb-2 text-lg font-bold"
            >
              {c.label}
              <span class="font-pixel text-xs font-normal opacity-90 truncate">{c.value}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<footer class={`bg-[#16161a] text-[#f5f4ef] border-t-2 border-line ${hideCta ? 'mt-24' : ''}`}>
  <div class="wrap py-12 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5 flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <img
          src={dossier.avatarUrl}
          alt=""
          class="pixel-img w-11 h-11 border-2 border-[#f5f4ef] bg-[#0e7f80]"
          width="44"
          height="44"
          loading="lazy"
        />
        <div>
          <p class="font-pixel text-sm">ROBIUL.HASAN</p>
          <p class="text-sm text-[#b9b8b2]">L2 Systems Engineer · Service Desk Co-Lead</p>
        </div>
      </div>
      <p class="text-sm text-[#b9b8b2] max-w-sm">
        Keeping 2,500+ endpoints boring for an Australian MSP. Building AI tools after hours.
      </p>
      <DhakaClock class="text-[#f2b31b]" />
    </div>

    <nav class="md:col-span-3" aria-label="Footer">
      <p class="kicker text-[#b9b8b2]">Pages</p>
      <ul class="mt-3 grid grid-cols-2 md:grid-cols-1 gap-y-1.5 gap-x-6 text-[15px]">
        {siteLinks.map((l) => (
          <li><a href={l.href} class="hover:text-[#f2b31b]">{l.name}</a></li>
        ))}
      </ul>
    </nav>

    <div class="md:col-span-4">
      <p class="kicker text-[#b9b8b2]">Elsewhere</p>
      <ul class="mt-3 grid gap-1.5 text-[15px]">
        <li>
          <a href="https://nextvector.rhasan.online/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-[#f2b31b]">
            NextVector — tech &amp; AI news <Icon name="external" class="w-3.5 h-3.5" />
          </a>
        </li>
        <li><a href={dossier.github} target="_blank" rel="noopener noreferrer" class="hover:text-[#f2b31b]">GitHub</a></li>
        <li><a href={dossier.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[#f2b31b]">LinkedIn</a></li>
        <li><a href={dossier.resumePdfUrl} download="Robiul_Hasan_CV.pdf" class="hover:text-[#f2b31b]">CV (PDF)</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="wrap py-5 flex flex-col sm:flex-row gap-2 justify-between text-sm text-[#b9b8b2]">
      <span>&copy; {currentYear} {dossier.name}</span>
      <span class="font-pixel text-xs">MADE IN DHAKA · RHASAN.ONLINE</span>
    </div>
  </div>
</footer>
