---
import { skillDomains } from '../data/skills';
---

<div class="w-full max-w-6xl mx-auto py-6">
  
  <!-- Tier Legend Strip -->
  <div class="mb-8 p-4 rounded-2xl bg-slate-900/60 light:bg-slate-100 border border-white/5 light:border-slate-300 flex flex-wrap items-center justify-between gap-4 text-xs">
    <span class="font-mono text-slate-400 light:text-slate-600 font-semibold uppercase tracking-wider text-[11px]">
      // Competency Tiers
    </span>
    <div class="flex flex-wrap items-center gap-4 text-xs font-mono">
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 light:text-amber-700 border border-amber-500/40 font-bold text-[11px]">
          ★ Mastery
        </span>
        <span class="text-slate-400 light:text-slate-600">Enterprise Lead & Architecture</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 light:text-cyan-700 border border-cyan-500/40 font-bold text-[11px]">
          ◆ Intermediate
        </span>
        <span class="text-slate-400 light:text-slate-600">Core Ops & Implementation</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full bg-slate-800 light:bg-slate-200 text-slate-300 light:text-slate-700 border border-white/10 light:border-slate-300 font-bold text-[11px]">
          ○ Beginner
        </span>
        <span class="text-slate-400 light:text-slate-600">Applied & Emerging</span>
      </div>
    </div>
  </div>

  <!-- Search & Domain Filter Bar -->
  <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-10 pb-6 border-b border-white/10 light:border-slate-200">
    
    <!-- Filter Chips -->
    <div class="flex items-center gap-1.5 flex-wrap">
      <button
        type="button"
        data-filter="all"
        class="skill-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold transition-all bg-amber-500/20 text-amber-400 border border-amber-500/40 cursor-pointer"
      >
        All Domains (6)
      </button>
      {skillDomains.map((domain) => (
        <button
          type="button"
          data-filter={domain.id}
          class="skill-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-slate-800/80 light:bg-slate-100 text-slate-400 light:text-slate-600 hover:text-slate-200 light:hover:text-slate-900 border border-white/5 light:border-slate-300 cursor-pointer"
        >
          {domain.shortTitle}
        </button>
      ))}
    </div>

    <!-- Live Search Input -->
    <div class="relative w-full md:w-64">
      <input
        id="skill-search-input"
        type="text"
        placeholder="Filter by keyword (e.g. Intune, EDR, Python)..."
        class="w-full pl-9 pr-4 py-2 rounded-xl bg-slate-900/90 light:bg-white border border-white/10 light:border-slate-300 focus:border-amber-500/50 focus:outline-none text-xs text-white light:text-slate-900 placeholder-slate-500 font-mono transition-colors"
      />
      <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

  </div>

  <!-- Domains High-Information Cards List -->
  <div id="skills-container" class="space-y-12">
    {skillDomains.map((domain) => (
      <div class="domain-block double-bezel-outer" data-domain-id={domain.id}>
        <div class="double-bezel-inner p-6 sm:p-8 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] light:bg-white space-y-6">
          
          <!-- Domain Header -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 pb-4 border-b border-white/10 light:border-slate-200">
            <div class="space-y-1.5">
              <div class="text-xs font-mono font-bold text-amber-500 tracking-wider">
                {domain.domainNumber}
              </div>
              <h3 class="text-2xl font-bold text-white light:text-slate-950 tracking-tight">
                {domain.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-400 light:text-slate-600 leading-relaxed max-w-3xl pt-1">
                {domain.description}
              </p>
            </div>

            <div class="flex items-center gap-2 self-start">
              <span class="font-mono text-[11px] px-3 py-1 rounded-md bg-amber-500/10 light:bg-amber-100 text-amber-400 light:text-amber-800 border border-amber-500/20 light:border-amber-300 font-bold whitespace-nowrap">
                {domain.badge}
              </span>
            </div>
          </div>

          <!-- 2x2 Rich Subcards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
            {domain.skills.map((skill) => {
              const isMastery = skill.proficiency === 'Mastery';
              const isIntermediate = skill.proficiency === 'Intermediate';
              
              return (
                <div
                  class="skill-subcard p-5 rounded-2xl bg-slate-950/60 light:bg-slate-50 border border-white/5 light:border-slate-200 hover:border-amber-500/30 transition-all flex flex-col justify-between space-y-3 group"
                  data-skill-name={skill.name.toLowerCase()}
                  data-skill-desc={skill.description.toLowerCase()}
                  data-skill-tags={skill.tags.join(' ').toLowerCase()}
                  data-skill-tier={skill.proficiency.toLowerCase()}
                >
                  <div class="space-y-2.5">
                    <!-- Subcard Title & Tier Badge -->
                    <div class="flex items-start justify-between gap-2">
                      <h4 class="text-sm font-bold text-white light:text-slate-900 group-hover:text-amber-400 light:group-hover:text-amber-600 transition-colors">
                        {skill.name}
                      </h4>
                      <div class="flex items-center gap-1.5 flex-shrink-0">
                        <span class={`text-[10px] font-mono px-2.5 py-0.5 rounded-full font-bold whitespace-nowrap ${
                          isMastery 
                            ? 'bg-amber-500/20 text-amber-300 light:text-amber-700 border border-amber-500/40 shadow-[0_0_10px_rgba(245,158,11,0.15)]' 
                            : isIntermediate 
                            ? 'bg-cyan-500/20 text-cyan-300 light:text-cyan-700 border border-cyan-500/40 shadow-[0_0_10px_rgba(6,182,212,0.15)]' 
                            : 'bg-slate-800 light:bg-slate-200 text-slate-300 light:text-slate-700 border border-white/10 light:border-slate-300'
                        }`}>
                          {isMastery ? '★ Mastery' : isIntermediate ? '◆ Intermediate' : '○ Beginner'}
                        </span>
                      </div>
                    </div>

                    <!-- Practical Description -->
                    <p class="text-xs text-slate-300 light:text-slate-600 leading-relaxed">
                      {skill.description}
                    </p>
                  </div>

                  <!-- Subcard Footer: Tags & Experience Tenure -->
                  <div class="pt-2 border-t border-white/5 light:border-slate-200 flex flex-wrap items-center justify-between gap-2 text-[10px] font-mono">
                    <div class="flex flex-wrap gap-1">
                      {skill.tags.map((tag) => (
                        <span class="px-2 py-0.5 rounded bg-slate-900 light:bg-white text-slate-400 light:text-slate-600 border border-white/5 light:border-slate-200 text-[9.5px]">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <span class="text-amber-400/80 light:text-amber-700 font-semibold">
                      {skill.experienceYears}
                    </span>
                  </div>

                </div>
              );
            })}
          </div>

        </div>
      </div>
    ))}
  </div>

  <!-- Empty state for search -->
  <div id="no-skills-msg" class="hidden text-center py-16 text-slate-400 text-sm font-mono">
    No competencies found matching your search term.
  </div>

</div>

<script>
  function setupSkillsFilter() {
    const filterBtns = document.querySelectorAll('.skill-filter-btn');
    const domainBlocks = document.querySelectorAll('.domain-block');
    const searchInput = document.getElementById('skill-search-input') as HTMLInputElement | null;
    const noResultsMsg = document.getElementById('no-skills-msg');

    let activeFilter = 'all';
    let searchQuery = '';

    function applyFilter() {
      let totalVisible = 0;

      domainBlocks.forEach((block) => {
        const domainId = block.getAttribute('data-domain-id');
        const matchesCategory = activeFilter === 'all' || activeFilter === domainId;

        const subcardsInBlock = block.querySelectorAll('.skill-subcard');
        let domainVisibleCards = 0;

        subcardsInBlock.forEach((card) => {
          const name = card.getAttribute('data-skill-name') || '';
          const desc = card.getAttribute('data-skill-desc') || '';
          const tags = card.getAttribute('data-skill-tags') || '';
          const tier = card.getAttribute('data-skill-tier') || '';
          
          const matchesSearch = !searchQuery || 
            name.includes(searchQuery) || 
            desc.includes(searchQuery) || 
            tags.includes(searchQuery) || 
            tier.includes(searchQuery);

          if (matchesCategory && matchesSearch) {
            (card as HTMLElement).style.display = 'flex';
            domainVisibleCards++;
            totalVisible++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        if (domainVisibleCards > 0) {
          (block as HTMLElement).style.display = 'block';
        } else {
          (block as HTMLElement).style.display = 'none';
        }
      });

      if (noResultsMsg) {
        noResultsMsg.classList.toggle('hidden', totalVisible > 0);
      }
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filterVal = btn.getAttribute('data-filter') || 'all';
        activeFilter = filterVal;

        filterBtns.forEach((b) => {
          if (b === btn) {
            b.className = 'skill-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold transition-all bg-amber-500/20 text-amber-400 border border-amber-500/40 cursor-pointer';
          } else {
            b.className = 'skill-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium transition-all bg-slate-800/80 light:bg-slate-100 text-slate-400 light:text-slate-600 hover:text-slate-200 light:hover:text-slate-900 border border-white/5 light:border-slate-300 cursor-pointer';
          }
        });

        applyFilter();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      applyFilter();
    });
  }

  setupSkillsFilter();
  document.addEventListener('astro:page-load', setupSkillsFilter);
</script>
