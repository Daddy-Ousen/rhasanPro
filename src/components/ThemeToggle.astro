---
// ThemeToggle.astro — flips <html class="dark"> and remembers the choice.
---

<button id="theme-toggle" type="button" class="btn btn-sm px-2.5" aria-label="Switch colour theme">
  <svg class="theme-moon w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
    <path stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
  <svg class="theme-sun w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
  </svg>
</button>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const label = () =>
      btn.setAttribute(
        'aria-label',
        document.documentElement.classList.contains('dark') ? 'Switch to light theme' : 'Switch to dark theme'
      );
    label();

    btn.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
      label();
    });
  }

  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
