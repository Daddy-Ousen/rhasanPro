---
// Contact Component: Direct Action Card with 1-Click Email Copy, mailto, CV Download, and Social Links
---

<section id="contact" class="space-y-6 pt-8 border-t border-slate-800 light:border-slate-200">
  <div class="flex items-center gap-3">
    <span class="text-xs font-mono text-amber-400 light:text-amber-600 uppercase tracking-wider font-semibold">Contact</span>
    <div class="h-px bg-slate-800 light:bg-slate-200 flex-1"></div>
  </div>

  <div class="p-8 sm:p-12 rounded-2xl bg-slate-900/60 light:bg-white border border-slate-800 light:border-slate-200 shadow-md text-center max-w-2xl mx-auto space-y-6">
    
    <div class="space-y-2">
      <h2 class="text-2xl sm:text-3xl font-bold text-white light:text-slate-950 tracking-tight">
        Let's discuss infrastructure and engineering opportunities.
      </h2>
      <p class="text-sm text-slate-300 light:text-slate-600 max-w-lg mx-auto">
        Currently exploring roles in Systems Administration, Enterprise Cloud Infrastructure, and Automation-adjacent engineering.
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      
      <!-- Copy Email Button -->
      <button 
        type="button" 
        data-copy-email="rhasan229@gmail.com" 
        class="w-full sm:w-auto px-6 py-3 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-amber-500/10 flex items-center justify-center gap-2 cursor-pointer active:scale-95"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <span>Copy Email (rhasan229@gmail.com)</span>
      </button>

      <!-- mailto Link -->
      <a 
        href="mailto:rhasan229@gmail.com" 
        class="w-full sm:w-auto px-5 py-3 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-200 light:text-slate-800 border border-slate-700 light:border-slate-300 text-sm font-medium transition-colors flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4 text-amber-400 light:text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <span>Open Mail Client</span>
      </a>

      <!-- Download CV Link -->
      <a 
        href="/Robiul_Hasan_CV.pdf" 
        download 
        class="w-full sm:w-auto px-5 py-3 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-200 light:text-slate-800 border border-slate-700 light:border-slate-300 text-sm font-medium transition-colors flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4 text-amber-400 light:text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <span>Download CV</span>
      </a>

    </div>

    <!-- Verified Outbound Links & Location (No Phone Number) -->
    <div class="flex items-center justify-center gap-6 pt-4 text-xs font-mono text-slate-400 light:text-slate-600">
      <a 
        href="https://linkedin.com/in/robiul-hasan-401296137" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hover:text-white light:hover:text-black underline underline-offset-4"
      >
        LinkedIn &nearr;
      </a>
      <span>&bull;</span>
      <a 
        href="https://github.com/Daddy-Ousen" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hover:text-white light:hover:text-black underline underline-offset-4"
      >
        GitHub &nearr;
      </a>
      <span>&bull;</span>
      <span>Dhaka, Bangladesh</span>
    </div>

  </div>
</section>
