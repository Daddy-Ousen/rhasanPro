---
import type { CredentialItem } from '../data/credentials';
import { credentialTone, toneClass } from '../data/tones';
import Icon from './Icon.astro';

interface Props {
  credential: CredentialItem;
}

const { credential } = Astro.props;
const band = toneClass[credentialTone[credential.category] ?? 'card'];
---

<article class="box lift flex flex-col h-full">
  <div class={`${band} border-b-2 border-line px-5 py-3 flex items-center justify-between gap-3`}>
    <span class="kicker">{credential.issuer}</span>
    {credential.verified && <span class="kicker">✓ Verified</span>}
  </div>

  <div class="p-5 sm:p-6 flex flex-col gap-3 flex-1">
    <p class="font-display font-extrabold text-[40px] leading-none tracking-tight [font-stretch:80%]">{credential.code}</p>
    <h3 class="font-bold text-lg leading-snug">{credential.title}</h3>
    <p class="text-[15px] leading-relaxed text-muted">{credential.description}</p>

    <ul class="mt-1 grid gap-1.5 text-[15px]">
      {credential.skillsValidated.map((skill) => (
        <li class="flex gap-2.5">
          <span class="led mt-2" aria-hidden="true"></span>
          <span>{skill}</span>
        </li>
      ))}
    </ul>

    <div class="mt-auto pt-5">
      {credential.verificationUrl ? (
        <a href={credential.verificationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-sm">
          Check it on {credential.issuer.split(' ')[0]} <Icon name="external" class="w-3.5 h-3.5" />
        </a>
      ) : (
        <p class="kicker text-muted">{credential.issuerBadge}</p>
      )}
    </div>
  </div>
</article>
