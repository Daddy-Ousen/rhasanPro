---
import { experiences } from '../data/experience';
---

<div class="relative w-full max-w-5xl mx-auto py-12">
  
  <!-- Neon Scroll Tracer Line -->
  <div class="absolute left-4 sm:left-1/2 top-8 bottom-8 w-[2px] -translate-x-1/2 bg-slate-800 hidden sm:block">
    <div
      id="timeline-tracer-line"
      class="w-full bg-gradient-to-b from-amber-400 via-emerald-400 to-amber-500 shadow-[0_0_12px_#f59e0b] origin-top h-0 transition-all duration-300"
    ></div>
  </div>

  <div class="space-y-16 relative">
    {experiences.map((exp, index) => {
      const isEven = index % 2 === 0;
      return (
        <div class="timeline-node relative grid grid-cols-1 sm:grid-cols-2 gap-8 items-center" data-index={index}>
          
          <!-- Timeline Center Pulse Marker -->
          <div class="hidden sm:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 items-center justify-center">
            <div class="w-8 h-8 rounded-full bg-[#0b0f17] border-2 border-amber-500/60 flex items-center justify-center shadow-[0_0_15px_rgba(245,158,11,0.5)] node-marker transition-all duration-300">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
            </div>
          </div>

          <!-- Left or Right Card Alignment -->
          <div class={`${isEven ? 'sm:col-start-1 sm:text-right' : 'sm:col-start-2 sm:text-left'} sm:px-4`}>
            <div class="double-bezel-outer group">
              <div class="double-bezel-inner p-6 sm:p-8 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] text-left">
                
                <!-- Period & Active Badge -->
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-mono font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                    {exp.period}
                  </span>
                  {exp.isCurrent && (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-mono font-bold border border-emerald-500/30">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      PRESENT ROLE
                    </span>
                  )}
                </div>

                <!-- Role & Company -->
                <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-amber-400 transition-colors">
                  {exp.role}
                </h3>
                <div class="text-xs text-slate-400 font-mono flex items-center gap-2 mt-1">
                  <span class="text-slate-200 font-semibold">{exp.company}</span>
                  <span>&bull;</span>
                  <span>{exp.companyType}</span>
                </div>

                <p class="text-xs text-slate-300 mt-3 leading-relaxed">
                  {exp.summary}
                </p>

                <!-- Key Metrics Strip -->
                {exp.metrics && exp.metrics.length > 0 && (
                  <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 my-4 pt-3 border-t border-white/5">
                    {exp.metrics.map((m) => (
                      <div class="p-2 rounded-lg bg-slate-900/80 border border-white/5">
                        <span class="block text-[10px] text-slate-400 font-mono truncate">{m.label}</span>
                        <span class="block text-xs font-bold font-mono text-amber-400">{m.value}</span>
                      </div>
                    ))}
                  </div>
                )}

                <!-- Detailed Bullet Highlights -->
                <ul class="space-y-2 mt-4 text-xs text-slate-300 border-t border-white/5 pt-3">
                  {exp.highlights.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-amber-400 font-bold mt-0.5">▹</span>
                      <span class="leading-relaxed">{item}</span>
                    </li>
                  ))}
                </ul>

                <!-- Tech Stack Badges -->
                <div class="flex flex-wrap gap-1.5 mt-5 pt-3 border-t border-white/5">
                  {exp.technologies.map((tech) => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800/90 text-slate-300 border border-white/5">
                      {tech}
                    </span>
                  ))}
                </div>

              </div>
            </div>
          </div>

          <!-- Empty opposite column for balanced spacing on desktop -->
          <div class={`hidden sm:block ${isEven ? 'sm:col-start-2' : 'sm:col-start-1'} pointer-events-none`}></div>

        </div>
      );
    })}
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function setupExperienceTracer() {
    const tracer = document.getElementById('timeline-tracer-line');
    const nodes = document.querySelectorAll('.timeline-node');

    if (!tracer || nodes.length === 0) return;

    // Animate the vertical tracer line based on scroll progress
    gsap.fromTo(
      tracer,
      { height: '0%' },
      {
        height: '100%',
        ease: 'none',
        scrollTrigger: {
          trigger: tracer.parentElement,
          start: 'top 80%',
          end: 'bottom 75%',
          scrub: 0.3,
        },
      }
    );

    // Stagger reveal nodes
    nodes.forEach((node) => {
      const marker = node.querySelector('.node-marker');
      const card = node.querySelector('.double-bezel-outer');

      gsap.fromTo(
        card,
        { y: 30, opacity: 0.2 },
        {
          y: 0,
          opacity: 1,
          duration: 0.7,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: node,
            start: 'top 90%',
            toggleActions: 'play none none none',
          },
        }
      );

      if (marker) {
        ScrollTrigger.create({
          trigger: node,
          start: 'top 75%',
          onEnter: () => {
            marker.classList.add('scale-125', 'border-amber-400', 'shadow-[0_0_20px_#f59e0b]');
          },
          onLeaveBack: () => {
            marker.classList.remove('scale-125', 'border-amber-400', 'shadow-[0_0_20px_#f59e0b]');
          },
        });
      }
    });
  }

  setupExperienceTracer();
  document.addEventListener('astro:page-load', setupExperienceTracer);
</script>
