---
import { experiences } from '../data/experience';
---

<ol class="grid gap-12">
  {experiences.map((exp) => (
    <li class="grid gap-4 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-3 md:sticky md:top-24 self-start flex md:flex-col flex-wrap items-center md:items-start gap-x-3 gap-y-2">
        <p class="font-pixel text-sm">{exp.period}</p>
        {exp.isCurrent && (
          <span class="kicker inline-flex items-center gap-2 fill-gold border-2 border-line px-2 py-1">
            <span class="led led-blink bg-[#16161a]" aria-hidden="true"></span>Now
          </span>
        )}
        <p class="text-sm text-muted">{exp.location}</p>
      </div>

      <article class="md:col-span-9 box lift">
        <header class="p-6 sm:p-8 border-b-2 border-line">
          <h2 class="h3 text-[clamp(26px,3vw,36px)]">{exp.role}</h2>
          <p class="mt-2 font-bold">
            {exp.company} <span class="font-normal text-muted">· {exp.companyType}</span>
          </p>
          <p class="mt-4 text-[17px] leading-relaxed max-w-[65ch]">{exp.summary}</p>
        </header>

        {exp.metrics.length > 0 && (
          <dl class="flex flex-wrap gap-[2px] bg-line border-b-2 border-line">
            {exp.metrics.map((m) => (
              <div class="flex-1 basis-[150px] bg-sunk px-5 py-4">
                <dt class="kicker text-muted">{m.label}</dt>
                <dd class="mt-1 font-display font-extrabold text-2xl leading-none tabular-nums">{m.value}</dd>
              </div>
            ))}
          </dl>
        )}

        <ul class="p-6 sm:p-8 grid gap-3 text-[16px] leading-relaxed">
          {exp.highlights.map((item) => (
            <li class="flex gap-3 max-w-[70ch]">
              <span class="led mt-2.5" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="px-6 sm:px-8 pb-6 sm:pb-8 flex flex-wrap gap-1.5 text-muted">
          {exp.technologies.map((tech) => <span class="tag">{tech}</span>)}
        </div>
      </article>
    </li>
  ))}
</ol>
