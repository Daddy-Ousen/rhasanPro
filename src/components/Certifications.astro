      <div class="space-y-4">
        <h3 class="text-base font-bold text-white light:text-slate-950">Formal Education</h3>
        
        <div class="p-4 rounded-lg bg-slate-950/60 light:bg-slate-50 border border-slate-800/80 light:border-slate-200 space-y-1.5">
          <div class="text-xs font-mono text-slate-400 light:text-slate-500">GRADUATED 2022 &bull; DHAKA, BANGLADESH</div>
          <div class="font-bold text-white light:text-slate-950 text-base">Bachelor of Business Administration (BBA)</div>
          <div class="text-xs text-slate-300 light:text-slate-700">Bangladesh University of Professionals (BUP)</div>
        </div>
      </div>

      <div class="p-4 rounded-lg bg-slate-950/60 light:bg-slate-50 border border-slate-800/80 light:border-slate-200 space-y-2">
