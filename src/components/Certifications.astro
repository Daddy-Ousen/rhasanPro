---
// Certifications & Education Component with Hackathons and Credentials
---

<section id="credentials" class="space-y-6 pt-8 border-t border-slate-800 light:border-slate-200">
  <div class="flex items-center gap-3">
    <span class="text-xs font-mono text-amber-400 light:text-amber-600 uppercase tracking-wider font-semibold">Credentials & Hackathons</span>
    <div class="h-px bg-slate-800 light:bg-slate-200 flex-1"></div>
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    
    <!-- Certifications & Hackathons Column -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <h3 class="text-base font-bold text-white light:text-slate-950">Certifications & Competitions</h3>
      
      <ul class="space-y-3 text-sm">
        <!-- Microsoft MD-102 -->
        <li class="p-3.5 rounded-lg bg-slate-950/60 light:bg-slate-50 border border-slate-800/80 light:border-slate-200 flex items-start justify-between gap-3">
          <div>
            <div class="font-semibold text-white light:text-slate-900">Microsoft 365 Certified: Endpoint Administrator Associate</div>
            <div class="text-xs text-slate-400 light:text-slate-500 font-mono mt-0.5">Exam MD-102 &bull; Microsoft</div>
