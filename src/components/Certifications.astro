          >
            <span>Verify &nearr;</span>
          </a>
        </li>

        <!-- Microsoft MD-100 -->
        <li class="p-3.5 rounded-lg bg-slate-950/60 light:bg-slate-50 border border-slate-800/80 light:border-slate-200 flex items-start justify-between gap-3">
          <div>
            <div class="font-semibold text-white light:text-slate-900">Microsoft Certified: Modern Desktop Administrator Associate</div>
            <div class="text-xs text-slate-400 light:text-slate-500 font-mono mt-0.5">Exam MD-100 &bull; Microsoft</div>
          </div>
          <span class="text-[11px] font-mono text-emerald-400 light:text-emerald-700 bg-emerald-500/10 light:bg-emerald-50 px-2 py-0.5 rounded border border-emerald-500/20 light:border-emerald-200 font-medium">Certified</span>
        </li>

        <!-- AMD AI Hackathon -->
        <li class="p-3.5 rounded-lg bg-slate-950/60 light:bg-slate-50 border border-slate-800/80 light:border-slate-200 flex items-start justify-between gap-3">
          <div>
            <div class="font-semibold text-white light:text-slate-950">AMD AI Developer Hackathon &mdash; Act II</div>
            <div class="text-xs text-slate-400 light:text-slate-500 mt-0.5">lablab.ai &bull; AMD AI Technology</div>
          </div>
          <a 
            href="https://lablab.ai/u/@rhasan22959110/ai-hackathons/amd-developer-hackathon-act-ii/certificate" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-[11px] font-mono text-amber-400 light:text-amber-700 bg-amber-500/10 light:bg-amber-50 px-2 py-0.5 rounded border border-amber-500/20 light:border-amber-200 font-medium hover:underline flex items-center gap-1"
