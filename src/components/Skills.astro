---
// Skills Component: 4 Structured Categories with Clear Visual Grouping
---

<section id="skills" class="space-y-6 pt-8 border-t border-slate-800 light:border-slate-200">
  <div class="flex items-center gap-3">
    <span class="text-xs font-mono text-amber-400 light:text-amber-600 uppercase tracking-wider font-semibold">Skills</span>
    <div class="h-px bg-slate-800 light:bg-slate-200 flex-1"></div>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
    
    <!-- 1. Cloud & Identity -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white light:text-slate-900 tracking-wide">Cloud & Identity</h3>
        <span class="text-xs font-mono text-amber-400 light:text-amber-600">01</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 light:text-slate-700">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Microsoft 365 Administration</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Microsoft Azure</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Entra ID (Azure AD)</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Exchange Online</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Microsoft Intune</span>
        </li>
      </ul>
    </div>

    <!-- 2. Infrastructure -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white light:text-slate-900 tracking-wide">Infrastructure</h3>
        <span class="text-xs font-mono text-slate-400 light:text-slate-500">02</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 light:text-slate-700">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Windows Server & Hyper-V</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Active Directory & Group Policy</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>DNS & Network Routing</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Datto BCDR & Datto RMM</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Endpoint & Antivirus Security</span>
        </li>
      </ul>
    </div>

    <!-- 3. Operations -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white light:text-slate-900 tracking-wide">Operations</h3>
        <span class="text-xs font-mono text-slate-400 light:text-slate-500">03</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 light:text-slate-700">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Incident & Escalation Management</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Service Desk Leadership</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>L1 Staff Training & Evaluation</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>IT Documentation & SOPs</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Client & Stakeholder Communication</span>
        </li>
      </ul>
    </div>

    <!-- 4. Automation & AI -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white light:text-slate-900 tracking-wide">Automation & AI</h3>
        <span class="text-xs font-mono text-emerald-400 light:text-emerald-600">04</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 light:text-slate-700">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Python & Bash Scripting</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Agentic LLM Workflow Automation</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Self-Hosted AI Deployment</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Headless Browser Automation</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Tool Calling Architecture</span>
        </li>
      </ul>
    </div>

  </div>

  <div class="pt-2 text-center sm:text-left">
    <a href="/skills" class="text-xs font-mono text-amber-400 light:text-amber-600 hover:underline inline-flex items-center gap-1 font-bold">
      <span>View Comprehensive Technical Competency Matrix &rarr;</span>
    </a>
  </div>
</section>
