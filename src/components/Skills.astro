---
// Skills Component: 6 Structured Domains Featuring Enterprise Cloud, Infrastructure, Security, BCDR, Operations, and AI/Web
---

<section id="skills" class="space-y-6 pt-8 border-t border-slate-800 light:border-slate-200">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="text-xs font-mono text-amber-400 light:text-amber-600 uppercase tracking-wider font-semibold">Skills & Platforms</span>
      <div class="h-px bg-slate-800 light:bg-slate-200 w-12 sm:w-24"></div>
    </div>
    <span class="text-xs font-mono text-slate-400 light:text-slate-500">Enterprise Infrastructure &bull; Security &bull; Automation</span>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    
    <!-- 1. Cloud & Identity -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white light:text-slate-950 tracking-wide">Cloud & Identity</h3>
        <span class="text-xs font-mono text-amber-400 light:text-amber-600">01</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 light:text-slate-700">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Microsoft 365 & Office 365 Admin</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Microsoft Azure & Azure Functions</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Entra ID (Azure AD) & User Lifecycle</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Microsoft Intune (MDM / MAM)</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Cloud & Tenant Migration</span>
        </li>
      </ul>
    </div>

    <!-- 2. Systems & Virtualization -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white light:text-slate-950 tracking-wide">Systems & Virtualization</h3>
        <span class="text-xs font-mono text-cyan-400 light:text-cyan-600">02</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 light:text-slate-700">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 light:bg-cyan-600"></span>
          <span>Windows Server & Windows 11</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 light:bg-cyan-600"></span>
          <span>Active Directory, GPO & Domain Mgmt</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 light:bg-cyan-600"></span>
          <span>Hyper-V & VMware Infrastructure</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 light:bg-cyan-600"></span>
          <span>Linux Administration</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 light:bg-cyan-600"></span>
          <span>DNS, DHCP & Enterprise Routing</span>
        </li>
      </ul>
    </div>

    <!-- 3. Endpoint Security & RMM -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white light:text-slate-950 tracking-wide">Endpoint & Security</h3>
        <span class="text-xs font-mono text-emerald-400 light:text-emerald-600">03</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 light:text-slate-700">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Bitdefender Endpoint Protection / EDR</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Threat & Vulnerability Assessment</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Email Security & Anti-Phishing</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Datto RMM, NinjaOne & ConnectWise</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Esper MDM & Kaseya</span>
        </li>
      </ul>
    </div>

    <!-- 4. BCDR & Business Continuity -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white light:text-slate-950 tracking-wide">BCDR & Data Continuity</h3>
        <span class="text-xs font-mono text-amber-400 light:text-amber-600">04</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 light:text-slate-700">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Datto BCDR Appliance Deployment</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Acronis Cyber Protect & Cloud Backup</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Disaster Recovery Testing & SDO Audits</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Automated Backup Verification & Alerts</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 light:bg-amber-600"></span>
          <span>Business Continuity Management (BCM)</span>
        </li>
      </ul>
    </div>

    <!-- 5. Operations & Service Leadership -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white light:text-slate-950 tracking-wide">Operations & Leadership</h3>
        <span class="text-xs font-mono text-slate-400 light:text-slate-500">05</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 light:text-slate-700">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Service Desk Co-Leadership & Management</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Incident Triaging & Escalation Resolution</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>L1 Team Training & Skills Development</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Technical SOPs & Knowledgebase Authoring</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>Enterprise IT Project Management</span>
        </li>
      </ul>
    </div>

    <!-- 6. Automation, AI & Software Engineering -->
    <div class="p-6 rounded-xl bg-slate-900/50 light:bg-white border border-slate-800 light:border-slate-200 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-white light:text-slate-950 tracking-wide">Automation & Software</h3>
        <span class="text-xs font-mono text-emerald-400 light:text-emerald-600">06</span>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 light:text-slate-700">
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Python Programming & Bash Scripting</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>AI Agents & Large Language Models (LLM)</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Next.js 15, React 19 & TypeScript</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>Astro & Tailwind CSS v4</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 light:bg-emerald-600"></span>
          <span>PostgreSQL & Playwright QA Testing</span>
        </li>
      </ul>
    </div>

  </div>

  <div class="pt-2 text-center sm:text-left">
    <a href="/skills" class="text-xs font-mono text-amber-400 light:text-amber-600 hover:underline inline-flex items-center gap-1 font-bold">
      <span>View Comprehensive Technical Competency Matrix &rarr;</span>
    </a>
  </div>
</section>
