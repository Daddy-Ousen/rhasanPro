---
// HermesChatWidget.astro — floating demo assistant backed by /api/chat.
import Icon from './Icon.astro';

const prompts = [
  "What is Robiul's MSP experience?",
  'What certifications does he hold?',
  'Tell me about Hermes AI',
  'How can I contact or hire Robiul?',
];
---

<div id="hermes-widget-container" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50">
  <div
    id="hermes-chat-drawer"
    class="box lift fixed inset-x-3 bottom-20 h-[72vh] sm:absolute sm:inset-x-auto sm:right-0 sm:bottom-16 sm:w-[400px] sm:h-[560px] max-h-[85vh] flex-col"
    role="dialog"
    aria-label="Hermes AI assistant"
    hidden
  >
    <div class="fill-navy border-b-2 border-line px-4 py-3 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 fill-gold border-2 border-line grid place-items-center font-pixel text-sm" aria-hidden="true">H</span>
        <div>
          <p class="font-bold leading-tight">Hermes</p>
          <p class="kicker opacity-80">Answers about Robiul</p>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button id="hermes-clear-btn" type="button" class="p-2 hover:bg-white/10" aria-label="Clear conversation">
          <Icon name="trash" class="w-4 h-4" />
        </button>
        <button id="hermes-close-btn" type="button" class="p-2 hover:bg-white/10" aria-label="Close assistant">
          <Icon name="close" class="w-5 h-5" />
        </button>
      </div>
    </div>

    <p class="kicker bg-sunk border-b-2 border-line px-4 py-2 text-muted">Demo · limit 5 messages per minute</p>

    <div id="hermes-messages-list" class="flex-1 overflow-y-auto p-4 grid content-start gap-3 text-[15px]" aria-live="polite">
      <div class="border-2 border-line bg-sunk p-3 leading-relaxed max-w-[92%]">
        <p class="font-bold">Hi, I'm Hermes.</p>
        <p class="mt-1">Ask me about Robiul's MSP work, certifications, projects, or how to reach him.</p>
      </div>
    </div>

    <div class="px-4 py-2 border-t-2 border-line flex gap-1.5 overflow-x-auto no-scrollbar">
      {prompts.map((p) => (
        <button type="button" class="hermes-chip chip text-[13px] py-1">{p}</button>
      ))}
    </div>

    <form id="hermes-chat-form" class="p-3 border-t-2 border-line grid gap-1.5">
      <div class="flex gap-2">
        <label for="hermes-input" class="sr-only">Your question</label>
        <input
          id="hermes-input"
          type="text"
          maxlength="350"
          placeholder="Ask a question…"
          autocomplete="off"
          class="field py-2"
        />
        <button id="hermes-send-btn" type="submit" class="btn btn-sm btn-teal" aria-label="Send">
          <Icon name="arrow" class="w-4 h-4" />
        </button>
      </div>
      <div class="flex justify-between font-pixel text-[11px] text-muted">
        <span id="hermes-status-text">READY</span>
        <span id="hermes-char-counter">0 / 350</span>
      </div>
    </form>
  </div>

  <button
    id="hermes-launcher-btn"
    type="button"
    class="btn"
    aria-expanded="false"
    aria-controls="hermes-chat-drawer"
  >
    <span class="led led-blink" aria-hidden="true"></span>
    Ask Hermes
    <span class="kicker fill-navy px-1.5 py-0.5">AI</span>
  </button>
</div>

<script>
  function escapeHtml(text: string) {
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function parseSimpleMarkdown(text: string): string {
    const html = escapeHtml(text)
      .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold">$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code class="font-mono text-[13px] bg-card border border-line px-1">$1</code>');

    return html
      .split('\n')
      .map((line) => {
        const t = line.trim();
        if (t.startsWith('- ') || t.startsWith('• ')) {
          return `<div class="flex gap-2 my-1"><span class="led mt-2"></span><span class="flex-1">${t.slice(2)}</span></div>`;
        }
        if (t.length === 0) return '<div class="h-2"></div>';
        return `<p>${t}</p>`;
      })
      .join('');
  }

  function setupHermesWidget() {
    const launcher = document.getElementById('hermes-launcher-btn');
    const drawer = document.getElementById('hermes-chat-drawer');
    const closeBtn = document.getElementById('hermes-close-btn');
    const clearBtn = document.getElementById('hermes-clear-btn');
    const form = document.getElementById('hermes-chat-form');
    const input = document.getElementById('hermes-input') as HTMLInputElement | null;
    const sendBtn = document.getElementById('hermes-send-btn') as HTMLButtonElement | null;
    const list = document.getElementById('hermes-messages-list');
    const counter = document.getElementById('hermes-char-counter');
    const status = document.getElementById('hermes-status-text');
    const chips = document.querySelectorAll<HTMLButtonElement>('.hermes-chip');

    if (!launcher || !drawer || !form || !input || !list) return;

    let busy = false;

    function setOpen(open: boolean) {
      drawer!.hidden = !open;
      drawer!.classList.toggle('flex', open);
      launcher!.setAttribute('aria-expanded', String(open));
      if (open) input!.focus();
    }

    launcher.addEventListener('click', () => setOpen(drawer.hidden));
    closeBtn?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) setOpen(false);
    });

    clearBtn?.addEventListener('click', () => {
      list.innerHTML = `<div class="border-2 border-line bg-sunk p-3 leading-relaxed max-w-[92%]"><p>Cleared. What else would you like to know?</p></div>`;
    });

    input.addEventListener('input', () => {
      if (counter) counter.textContent = `${input.value.length} / 350`;
    });

    function append(sender: 'user' | 'hermes', content: string, isError = false) {
      const el = document.createElement('div');
      if (sender === 'user') {
        el.className = 'justify-self-end max-w-[85%] fill-teal border-2 border-line p-3 leading-relaxed font-medium';
        el.textContent = content;
      } else {
        el.className = isError
          ? 'max-w-[92%] border-2 border-pink bg-card p-3 leading-relaxed'
          : 'max-w-[92%] border-2 border-line bg-sunk p-3 leading-relaxed';
        el.innerHTML = parseSimpleMarkdown(content);
      }
      list!.appendChild(el);
      list!.scrollTo({ top: list!.scrollHeight, behavior: 'smooth' });
      return el;
    }

    async function send(text: string) {
      const q = text.trim();
      if (!q || busy) return;

      append('user', q);
      input!.value = '';
      if (counter) counter.textContent = '0 / 350';
      busy = true;
      if (sendBtn) sendBtn.disabled = true;
      if (status) status.textContent = 'THINKING…';

      const loader = append('hermes', '…');

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: q }),
        });
        const data = await res.json();
        loader.remove();
        if (!res.ok) append('hermes', data.error || 'That request failed. Try again in a minute.', true);
        else append('hermes', data.reply || 'No answer came back. Try asking another way.');
      } catch {
        loader.remove();
        append('hermes', 'Hermes could not be reached. Check your connection, or email Robiul directly.', true);
      } finally {
        busy = false;
        if (sendBtn) sendBtn.disabled = false;
        if (status) status.textContent = 'READY';
        input!.focus();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      send(input.value);
    });

    chips.forEach((chip) => chip.addEventListener('click', () => send(chip.textContent || '')));
  }

  document.addEventListener('astro:page-load', setupHermesWidget);
</script>
