---
import type { CredentialItem } from '../data/credentials';

interface Props {
  credential: CredentialItem;
}

const { credential } = Astro.props;
---

<div class="tilt-card-wrapper perspective-1000 group">
  <div
    class="tilt-card double-bezel-outer transition-transform duration-200 ease-out will-change-transform"
    style="transform-style: preserve-3d;"
  >
    <div class="double-bezel-inner p-6 sm:p-7 rounded-[calc(1.5rem-1.5px)] bg-[#0f1420] h-full flex flex-col justify-between relative overflow-hidden">
      
      <!-- Holographic Glare Overlay -->
      <div class="holo-glare absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-40 transition-opacity duration-300 bg-gradient-to-tr from-transparent via-white/15 to-transparent"></div>

      <div>
        <!-- Card Top Bar: Issuer & Verified Status -->
        <div class="flex items-center justify-between gap-2 mb-4">
          <div class="flex items-center gap-2">
            <span class="p-2 rounded-xl bg-slate-900 border border-white/10 text-amber-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </span>
            <div>
              <span class="text-xs font-bold text-slate-200 block">{credential.issuer}</span>
              <span class="text-[10px] font-mono text-slate-400 block">{credential.issuerBadge}</span>
            </div>
          </div>

          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-mono font-bold border border-emerald-500/20">
            <svg class="w-3 h-3 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            VERIFIED
          </span>
        </div>

        <!-- Credential Code & Title -->
        <span class="inline-block px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20 mb-2">
          {credential.code}
        </span>
        <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-amber-400 transition-colors leading-snug">
          {credential.title}
        </h3>

        <p class="text-xs text-slate-400 mt-2.5 leading-relaxed">
          {credential.description}
        </p>

        <!-- Validated Skills List -->
        <div class="mt-4 pt-4 border-t border-white/5 space-y-1.5">
          <span class="text-[10px] font-mono uppercase tracking-wider text-slate-500 block mb-1.5">Validated Competencies</span>
          {credential.skillsValidated.map((skill) => (
            <div class="flex items-center gap-2 text-xs text-slate-300">
              <span class="text-emerald-400 font-bold text-[10px]">✔</span>
              <span>{skill}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Action Button / Verification Link -->
      <div class="mt-6 pt-4 border-t border-white/5">
        {credential.verificationUrl ? (
          <a
            href={credential.verificationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-amber-400 border border-amber-500/30 hover:border-amber-500/60 shadow-sm transition-all group/btn"
          >
            <span>Verify Official Credential</span>
            <div class="w-5 h-5 rounded-full bg-amber-500/20 flex items-center justify-center text-amber-400 group-hover/btn:translate-x-1 transition-transform">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
          </a>
        ) : (
          <div class="text-[11px] font-mono text-slate-400 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
            <span>Issued via Enterprise & Academic Program</span>
          </div>
        )}
      </div>

    </div>
  </div>
</div>

<script>
  function setup3DTiltCards() {
    const cards = document.querySelectorAll('.tilt-card-wrapper');

    cards.forEach((wrapper) => {
      const card = wrapper.querySelector('.tilt-card') as HTMLElement | null;
      const glare = wrapper.querySelector('.holo-glare') as HTMLElement | null;
      if (!card) return;

      wrapper.addEventListener('mousemove', (e: Event) => {
        const mouseEvent = e as MouseEvent;
        const rect = (wrapper as HTMLElement).getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -10; // Max 10deg
        const rotateY = ((x - centerX) / centerX) * 10;

        card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;

        if (glare) {
          const glareX = (x / rect.width) * 100;
          const glareY = (y / rect.height) * 100;
          glare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255,255,255,0.2) 0%, transparent 60%)`;
        }
      });

      wrapper.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        card.style.transition = 'transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
      });

      wrapper.addEventListener('mouseenter', () => {
        card.style.transition = 'none';
      });
    });
  }

  setup3DTiltCards();
  document.addEventListener('astro:page-load', setup3DTiltCards);
</script>
