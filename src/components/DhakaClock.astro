---
// DhakaClock.astro — live local time in Dhaka. Safe to use more than once per page.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2 font-pixel text-xs ${cls}`}>
  <span class="led led-blink" aria-hidden="true"></span>
  <span>DHAKA</span>
  <time class="dhaka-time tabular-nums">--:-- --</time>
</span>

<script>
  function initDhakaClocks() {
    const displays = document.querySelectorAll<HTMLElement>('.dhaka-time');
    if (displays.length === 0) return;

    const formatter = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Dhaka',
      hour: '2-digit',
      minute: '2-digit',
      hour12: true,
    });

    const update = () => {
      const text = formatter.format(new Date());
      displays.forEach((d) => (d.textContent = text));
    };

    update();
    const interval = setInterval(update, 15000);
    document.addEventListener('astro:before-swap', () => clearInterval(interval), { once: true });
  }

  document.addEventListener('astro:page-load', initDhakaClocks);
</script>
