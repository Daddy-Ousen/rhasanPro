---
import { ClientRouter } from 'astro:transitions';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LenisScroll from '../components/LenisScroll.astro';
import HermesChatWidget from '../components/HermesChatWidget.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideFooterCta?: boolean;
}

const { title, description, image, hideFooterCta = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} image={image} />
    <script is:inline>
      (function () {
        function applyTheme(doc) {
          var dark = false;
          try {
            var saved = localStorage.getItem('theme');
            dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          } catch (e) {}
          doc.documentElement.classList.toggle('dark', dark);
        }
        applyTheme(document);
        // View transitions replace <html> attributes; re-apply on the incoming page.
        document.addEventListener('astro:before-swap', function (e) { applyTheme(e.newDocument); });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link btn btn-sm">Skip to content</a>

    <Header />

    <main id="main" class="w-full">
      <slot />
    </main>

    <Footer hideCta={hideFooterCta} />

    <HermesChatWidget />
    <LenisScroll />
    <Analytics />
  </body>
</html>
